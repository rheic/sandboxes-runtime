@@ -17,9 +17,53 @@
 package libkrun
 
 import (
+	"context"
+	"net"
+	"sync/atomic"
 	"testing"
+	"time"
+
+	"github.com/containerd/ttrpc"
 )
 
+type closeCountingConn struct {
+	net.Conn
+	closeCalls atomic.Int32
+}
+
+func (c *closeCountingConn) Close() error {
+	c.closeCalls.Add(1)
+	return c.Conn.Close()
+}
+
+func TestCloseTTRPCConnectionClosesClientOwnedConnOnce(t *testing.T) {
+	clientConn, peerConn := net.Pipe()
+	t.Cleanup(func() { _ = peerConn.Close() })
+	conn := &closeCountingConn{Conn: clientConn}
+	client := ttrpc.NewClient(conn)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+
+	closeTTRPCConnection(ctx, client, conn)
+	if err := client.UserOnCloseWait(ctx); err != nil {
+		t.Fatalf("wait for TTRPC client close: %v", err)
+	}
+	if got := conn.closeCalls.Load(); got != 1 {
+		t.Fatalf("underlying connection close calls = %d, want 1", got)
+	}
+}
+
+func TestCloseTTRPCConnectionClosesRawConnWhenClientUnavailable(t *testing.T) {
+	clientConn, peerConn := net.Pipe()
+	t.Cleanup(func() { _ = peerConn.Close() })
+	conn := &closeCountingConn{Conn: clientConn}
+
+	closeTTRPCConnection(context.Background(), nil, conn)
+	if got := conn.closeCalls.Load(); got != 1 {
+		t.Fatalf("underlying connection close calls = %d, want 1", got)
+	}
+}
