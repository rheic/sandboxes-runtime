+// runtimeAssetSearchPaths treats an explicit LIBKRUN_PATH as the complete
+// runtime bundle and rejects empty or relative entries. Without an explicit
+// bundle, only fixed system directories are searched; PATH is not trusted for
+// native runtime libraries or boot assets.
+func runtimeAssetSearchPaths(libkrunPathEnv, goos string) []string {
+	if explicitPaths := filepath.SplitList(libkrunPathEnv); len(explicitPaths) != 0 {
+		return absolutePaths(explicitPaths)
+	}
+	var libPaths []string
+	if goos != "windows" {
+		libPaths = []string{"/usr/local/lib", "/usr/local/lib64", "/usr/lib", "/lib"}
+	}
+	if goos == "darwin" {
+		libPaths = append(libPaths, "/opt/homebrew/lib")
+	}
+	return libPaths
+}
+
+func absolutePaths(paths []string) []string {
+	filtered := make([]string, 0, len(paths))
+	for _, dir := range paths {
+		if dir == "" || !filepath.IsAbs(dir) {
+			continue
+		}
+		filtered = append(filtered, dir)
+	}
+	return filtered
+}
