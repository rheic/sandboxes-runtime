diff --git a/internal/shim/task/mount_cleanup_linux_test.go b/internal/shim/task/mount_cleanup_linux_test.go
new file mode 100644
index 0000000..be8d1a6
--- /dev/null
+++ b/internal/shim/task/mount_cleanup_linux_test.go
@@ -0,0 +1,68 @@
+//go:build linux
+
+package task
+
+import (
+	"errors"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestUnmountHostMountPathsDeduplicatesBundleTargets(t *testing.T) {
+	base := t.TempDir()
+	mounts := filepath.Join(base, "mounts")
+	rootfs := filepath.Join(base, "rootfs")
+	var got []string
+	err := unmountHostMountPathsWith([]string{mounts, rootfs, mounts}, func(path string) error {
+		got = append(got, path)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{mounts, rootfs}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("unmounted paths = %v, want %v", got, want)
+	}
+}
+
+func TestUnmountHostMountPathsRejectsUntrustedTargets(t *testing.T) {
+	called := false
+	err := unmountHostMountPathsWith([]string{"relative/mounts", filepath.Join(t.TempDir(), "outside")}, func(string) error {
+		called = true
+		return nil
+	})
+	if err == nil {
+		t.Fatal("expected invalid mount paths to be rejected")
+	}
+	if called {
+		t.Fatal("unmount callback ran for an invalid path")
+	}
+}
+
+func TestUnmountHostMountPathsReturnsUnmountFailure(t *testing.T) {
+	wantErr := errors.New("unmount failed")
+	path := filepath.Join(t.TempDir(), "mounts")
+	err := unmountHostMountPathsWith([]string{path}, func(string) error { return wantErr })
+	if !errors.Is(err, wantErr) {
+		t.Fatalf("unmount error = %v, want wrapped %v", err, wantErr)
+	}
+}
+
+func TestRemainingHostMountPathsPreservesOwnershipUntilCleanupSucceeds(t *testing.T) {
+	first := filepath.Join(t.TempDir(), "mounts")
+	second := filepath.Join(t.TempDir(), "rootfs")
+	concurrent := filepath.Join(t.TempDir(), "mounts")
+	current := []string{first, second, concurrent}
+
+	got := remainingHostMountPaths(current, []string{first, second})
+	if want := []string{concurrent}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("remaining paths = %v, want concurrent ownership %v", got, want)
+	}
+	if got := remainingHostMountPaths(current, []string{first, "unexpected"}); !reflect.DeepEqual(got, current) {
+		t.Fatalf("mismatched cleanup cleared ownership: got %v, want %v", got, current)
+	}
+	if got := remainingHostMountPaths(current, nil); !reflect.DeepEqual(got, current) {
+		t.Fatalf("empty cleanup changed ownership: got %v, want %v", got, current)
+	}
+}
