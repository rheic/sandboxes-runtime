diff --git a/pkg/shim/manager/mount_cleanup.go b/pkg/shim/manager/mount_cleanup.go
new file mode 100644
index 0000000..2719810
--- /dev/null
+++ b/pkg/shim/manager/mount_cleanup.go
@@ -0,0 +1,61 @@
+package manager
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/containerd/containerd/v2/pkg/shim"
+)
+
+// cleanupBundleMountsWith removes mounts only below the two fixed mount roots
+// owned by the task bundle. It is called from the containerd delete action,
+// after Stop has waited for the shim process lock to be released.
+func cleanupBundleMountsWith(ctx context.Context, unmount func(string) error) error {
+	opts, ok := ctx.Value(shim.OptsKey{}).(shim.Opts)
+	if !ok || opts.BundlePath == "" {
+		return errors.New("shim bundle path is unavailable")
+	}
+	bundle := filepath.Clean(opts.BundlePath)
+	if !filepath.IsAbs(bundle) || bundle == string(filepath.Separator) {
+		return fmt.Errorf("refusing invalid shim bundle path %q", opts.BundlePath)
+	}
+	info, err := os.Lstat(bundle)
+	if err != nil {
+		return fmt.Errorf("inspect shim bundle: %w", err)
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("refusing non-directory or symlink shim bundle %q", bundle)
+	}
+
+	targets, err := bundleMountTargets(bundle)
+	if err != nil {
+		return err
+	}
+	for _, target := range targets {
+		info, err := os.Lstat(target)
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("inspect bundle mount root %q: %w", target, err)
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("refusing non-directory or symlink bundle mount root %q", target)
+		}
+		if err := unmount(target); err != nil {
+			return fmt.Errorf("unmount bundle path %q: %w", target, err)
+		}
+	}
+	return nil
+}
+
+func bundleMountTargets(bundle string) ([]string, error) {
+	clean := filepath.Clean(bundle)
+	if !filepath.IsAbs(clean) || clean == string(filepath.Separator) {
+		return nil, fmt.Errorf("invalid bundle path %q", bundle)
+	}
+	return []string{filepath.Join(clean, "mounts"), filepath.Join(clean, "rootfs")}, nil
+}
diff --git a/pkg/shim/manager/mount_cleanup_test.go b/pkg/shim/manager/mount_cleanup_test.go
new file mode 100644
index 0000000..a75bdad
--- /dev/null
+++ b/pkg/shim/manager/mount_cleanup_test.go
@@ -0,0 +1,83 @@
+package manager
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/containerd/containerd/v2/pkg/shim"
+)
+
+func TestBundleMountTargetsAreFixedChildren(t *testing.T) {
+	got, err := bundleMountTargets("/var/lib/containerd/io.containerd.runtime.v2.task/default/id")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"/var/lib/containerd/io.containerd.runtime.v2.task/default/id/mounts",
+		"/var/lib/containerd/io.containerd.runtime.v2.task/default/id/rootfs",
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("targets = %v, want %v", got, want)
+	}
+	for _, invalid := range []string{"", "relative/bundle", string(filepath.Separator)} {
+		if _, err := bundleMountTargets(invalid); err == nil {
+			t.Errorf("bundleMountTargets(%q) succeeded", invalid)
+		}
+	}
+}
+
+func TestCleanupBundleMountsUsesOnlyExistingFixedTargets(t *testing.T) {
+	bundle := t.TempDir()
+	for _, name := range []string{"mounts", "rootfs", "unrelated"} {
+		if err := os.Mkdir(filepath.Join(bundle, name), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ctx := context.WithValue(context.Background(), shim.OptsKey{}, shim.Opts{BundlePath: bundle})
+	var got []string
+	err := cleanupBundleMountsWith(ctx, func(path string) error {
+		got = append(got, path)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{filepath.Join(bundle, "mounts"), filepath.Join(bundle, "rootfs")}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("unmounted paths = %v, want %v", got, want)
+	}
+}
+
+func TestCleanupBundleMountsRejectsSymlinkTarget(t *testing.T) {
+	bundle := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(bundle, "mounts")); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.WithValue(context.Background(), shim.OptsKey{}, shim.Opts{BundlePath: bundle})
+	called := false
+	if err := cleanupBundleMountsWith(ctx, func(string) error { called = true; return nil }); err == nil {
+		t.Fatal("expected symlink target refusal")
+	}
+	if called {
+		t.Fatal("unmount callback ran for symlink target")
+	}
+}
+
+func TestCleanupBundleMountsRequiresTrustedBundleContext(t *testing.T) {
+	if err := cleanupBundleMountsWith(context.Background(), func(string) error { return nil }); err == nil {
+		t.Fatal("expected missing bundle context error")
+	}
+	bundle := t.TempDir()
+	link := bundle + "-link"
+	if err := os.Symlink(bundle, link); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.WithValue(context.Background(), shim.OptsKey{}, shim.Opts{BundlePath: link})
+	if err := cleanupBundleMountsWith(ctx, func(string) error { return nil }); err == nil {
+		t.Fatal("expected symlink bundle refusal")
+	}
+}
