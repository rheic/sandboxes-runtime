@@ -18,7 +18,9 @@ package task
 
 import (
 	"context"
+	"errors"
 	"fmt"
+	"path/filepath"
 
 	"github.com/containerd/containerd/api/types"
 	"github.com/containerd/containerd/v2/core/mount"
@@ -28,6 +30,54 @@ import (
 	"github.com/containerd/nerdbox/internal/shim/sandbox"
 )
 
+func unmountHostMountPaths(paths []string) error {
+	return unmountHostMountPathsWith(paths, func(path string) error {
+		return mount.UnmountRecursive(path, 0)
+	})
+}
+
+func unmountHostMountPathsWith(paths []string, unmount func(string) error) error {
+	seen := make(map[string]struct{}, len(paths))
+	var errs []error
+	for _, path := range paths {
+		if path == "" {
+			continue
+		}
+		cleanPath := filepath.Clean(path)
+		if !filepath.IsAbs(cleanPath) {
+			errs = append(errs, fmt.Errorf("refusing non-absolute mount path %q", path))
+			continue
+		}
+		base := filepath.Base(cleanPath)
+		if base != "mounts" && base != "rootfs" {
+			errs = append(errs, fmt.Errorf("refusing unexpected mount path %q", path))
+			continue
+		}
+		if _, ok := seen[cleanPath]; ok {
+			continue
+		}
+		seen[cleanPath] = struct{}{}
+		if err := unmount(cleanPath); err != nil {
+			errs = append(errs, fmt.Errorf("unmount %q: %w", cleanPath, err))
+		}
+	}
+	return errors.Join(errs...)
+}
+
+// remainingHostMountPaths forgets only the successfully cleaned prefix. If
+// ownership changed concurrently, it preserves the full current list.
+func remainingHostMountPaths(current, cleaned []string) []string {
+	if len(cleaned) > len(current) {
+		return current
+	}
+	for i, path := range cleaned {
+		if current[i] != path {
+			return current
+		}
+	}
+	return append([]string(nil), current[len(cleaned):]...)
+}
+
