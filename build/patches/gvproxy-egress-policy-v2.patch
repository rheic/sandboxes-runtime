+func TestClientHelloSNIRejectsECH(t *testing.T) {
+	body := make([]byte, 47)
+	body[0], body[1] = 3, 3 // legacy_version
+	body[34] = 0 // empty session ID
+	copy(body[35:39], []byte{0, 2, 0x13, 1}) // one cipher suite
+	body[39], body[40] = 1, 0 // null compression
+	copy(body[41:47], []byte{0, 4, 0xfe, 0x0d, 0, 0}) // encrypted_client_hello extension
+	clientHello := append([]byte{1, 0, 0, byte(len(body))}, body...)
+	if _, err := clientHelloSNI(clientHello); err == nil {
+		t.Fatal("ECH ClientHello accepted for domain classification")
+	}
+}
+
+func FuzzParseClientInitialNeverPanics(f *testing.F) {
+	f.Add([]byte{0xc0, 0, 0, 0, 1, 8, 1, 2, 3, 4, 5, 6, 7, 8, 0, 0, 0})
+	f.Fuzz(func(t *testing.T, b []byte) {
+		if len(b) > MaxInitialDatagram {
+			t.Skip()
+		}
+		_, _, _ = ParseClientInitial(b)
+	})
+}
+
+func makeTestInitial(t *testing.T, version uint32, sni string) []byte {
+	t.Helper()
+	host := []byte(sni)
+	name := append([]byte{0}, testUint16Length(t, len(host))...)
+	name = append(name, host...)
+	list := append(testUint16Length(t, len(name)), name...)
+	ext := append([]byte{0, 0}, testUint16Length(t, len(list))...)
+	ext = append(ext, list...)
+	body := make([]byte, 2+32+1+2+2+1+1+2+len(ext))
+	body[0] = 3
+	body[1] = 3
+	pos := 2 + 32
+	body[pos] = 0
+	pos++
+	binary.BigEndian.PutUint16(body[pos:], 2)
+	pos += 2
+	body[pos] = 0x13
+	body[pos+1] = 1
+	pos += 2
+	body[pos] = 1
+	body[pos+1] = 0
+	pos += 2
+	binary.BigEndian.PutUint16(body[pos:], testUint16(t, len(ext)))
+	pos += 2
+	copy(body[pos:], ext)
+	handshake := []byte{1, testByte(t, len(body)>>16), testByte(t, len(body)>>8), testByte(t, len(body))}
+	handshake = append(handshake, body...)
+	crypto := append([]byte{6, 0}, testVarint(uint64(len(handshake)))...)
+	crypto = append(crypto, handshake...)
+	// PADDING keeps the test packet large enough for QUIC's HP sample and the
+	// standard minimum client Initial datagram size.
+	plain := make([]byte, 1200)
+	if len(crypto) > len(plain) {
+		t.Fatal("test ClientHello exceeds Initial payload")
+	}
+	copy(plain, crypto)
+	dcid := []byte{0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08}
+	first := byte(0xc3)
+	if version == Version2 {
+		first = 0xd3
+	}
+	header := []byte{first, 0, 0, 0, 0}
+	binary.BigEndian.PutUint32(header[1:], version)
+	header = append(header, testByte(t, len(dcid)))
+	header = append(header, dcid...)
+	header = append(header, 0, 0) // empty SCID, empty token length
+	packetLen := 4 + len(plain) + 16
+	header = append(header, byte((packetLen>>8)&0x3f)|0x40, byte(packetLen&0xff))
+	pnOffset := len(header)
+	header = append(header, 0, 0, 0, 2)
+	keys, err := deriveInitialKeys(version, dcid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	block, _ := aes.NewCipher(keys.key)
+	aead, _ := cipher.NewGCM(block)
+	nonce := append([]byte(nil), keys.iv...)
+	nonce[len(nonce)-1] ^= 2
+	sealed := aead.Seal(nil, nonce, plain, header)
+	header = append(header, sealed...)
+	packet := header
+	hp, _ := aes.NewCipher(keys.hp)
+	var mask [aes.BlockSize]byte
+	hp.Encrypt(mask[:], packet[pnOffset+4:pnOffset+4+aes.BlockSize])
+	packet[0] ^= mask[0] & 0x0f
+	for i := 0; i < 4; i++ {
+		packet[pnOffset+i] ^= mask[i+1]
+	}
+	return packet
+}
+
+func testVarint(v uint64) []byte {
+	switch {
+	case v < 1<<6:
+		return []byte{byte(v)}
+	case v < 1<<14:
+		return []byte{byte((v>>8)&0x3f) | 0x40, byte(v & 0xff)}
+	default:
+		panic("test varint too large")
+	}
+}
+
+func testUint16Length(t *testing.T, length int) []byte {
+	t.Helper()
+	encoded := make([]byte, 2)
+	binary.BigEndian.PutUint16(encoded, testUint16(t, length))
+	return encoded
+}
+
+func testUint16(t *testing.T, length int) uint16 {
+	t.Helper()
+	if length < 0 || length > 0xffff {
+		t.Fatalf("test length %d does not fit uint16", length)
+	}
+	//nolint:gosec // length is checked against the uint16 maximum above.
+	return uint16(length)
+}
+
+func testByte(t *testing.T, value int) byte {
+	t.Helper()
+	if value < 0 || value > 0xff {
+		t.Fatalf("test value %d does not fit uint8", value)
+	}
+	//nolint:gosec // value is checked against the uint8 maximum above.
+	return byte(value)
+}
