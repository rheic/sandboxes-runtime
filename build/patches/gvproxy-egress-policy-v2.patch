+package tap
+
+import (
+	"io"
+	"net"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+func TestSwitchFloodsIPv6MulticastToConnectedGuest(t *testing.T) {
+	gateway, guest := net.Pipe()
+	defer gateway.Close()
+	defer guest.Close()
+	s := NewSwitch(false)
+	s.conns[1] = protocolConn{Conn: gateway, protocolImpl: protocolImplementation(types.VfkitProtocol)}
+	frame := make([]byte, 14+8)
+	copy(frame[:6], []byte{0x33, 0x33, 0, 0, 0, 1})
+	copy(frame[6:12], []byte{0x02, 0, 0, 0, 0, 1})
+	frame[12], frame[13] = 0x86, 0xdd
+	packet := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(frame)})
+	defer packet.DecRef()
+	written := make(chan error, 1)
+	go func() { written <- s.txPkt(packet) }()
+	got := make([]byte, len(frame))
+	if _, err := io.ReadFull(guest, got); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != string(frame) {
+		t.Fatal("multicast Ethernet frame was changed")
+	}
+}
+
+type packetRecordingGateway struct {
+	address tcpip.LinkAddress
+	packets chan []byte
+}
+
+func (g *packetRecordingGateway) DeliverNetworkPacket(_ tcpip.NetworkProtocolNumber, packet *stack.PacketBuffer) {
+	g.packets <- packet.ToView().AsSlice()
+}
+func (g *packetRecordingGateway) LinkAddress() tcpip.LinkAddress { return g.address }
+func (g *packetRecordingGateway) IP() string                     { return "192.0.2.1" }
+
+func TestSwitchDeliversIPv6MulticastToGateway(t *testing.T) {
+	gateway := &packetRecordingGateway{address: tcpip.LinkAddress([]byte{0x02, 0, 0, 0, 0, 1}), packets: make(chan []byte, 1)}
+	s := NewSwitch(false)
+	s.Connect(gateway)
+	frame := make([]byte, 14+40)
+	copy(frame[:6], []byte{0x33, 0x33, 0, 0, 0, 1})
+	copy(frame[6:12], []byte{0x02, 0, 0, 0, 0, 2})
+	frame[12], frame[13] = 0x86, 0xdd
+	packet := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(frame)})
+	defer packet.DecRef()
+	s.rxBuf(t.Context(), 1, frame)
+	select {
+	case got := <-gateway.packets:
+		if string(got) != string(frame[14:]) {
+			t.Fatal("gateway received a changed IPv6 multicast payload")
+		}
+	default:
+		t.Fatal("gateway did not receive guest IPv6 multicast frame")
+	}
+}
+
+func TestSwitchDoesNotTreatUnicastAsMulticast(t *testing.T) {
+	for _, address := range []net.HardwareAddr{{0x02, 0, 0, 0, 0, 1}, {0x33, 0x33, 0, 0, 0, 1}, {0xff, 0xff, 0xff, 0xff, 0xff, 0xff}} {
+		got := isEthernetMulticast(tcpip.LinkAddress(address))
+		want := address[0]&1 != 0
+		if got != want {
+			t.Fatalf("isEthernetMulticast(%x)=%t want %t", address, got, want)
+		}
+	}
+}
