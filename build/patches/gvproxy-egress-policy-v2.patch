+func TestIPv6PolicyFamilyIsolationAndDenyWins(t *testing.T) {
+	holder, err := NewEgressPolicyHolder(&EgressPolicy{
+		Allow: []EgressRule{{Protocol: "tcp", CIDR: "0.0.0.0/0", Port: 443}, {Protocol: "tcp", CIDR: "2001:db8::/32", Port: 443}},
+		Deny:  []EgressRule{{Protocol: "tcp", CIDR: "2001:db8:dead::/48", Port: 443}},
+	}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	if !holder.Allows("tcp", "2001:db8::1", 443) {
+		t.Fatal("IPv6 positive control was denied")
+	}
+	if holder.Allows("tcp", "2001:db8:dead::1", 443) {
+		t.Fatal("IPv6 deny rule did not take precedence")
+	}
+	if !holder.Allows("tcp", "192.0.2.1", 443) {
+		t.Fatal("IPv4 positive control was denied")
+	}
+	if holder.Allows("tcp", "2001:db9::1", 443) {
+		t.Fatal("IPv6 destination outside the allowed prefix was permitted")
+	}
+	if !holder.Allows("tcp", "::ffff:192.0.2.1", 443) {
+		t.Fatal("IPv4-mapped IPv6 destination was not normalized to IPv4")
+	}
+}
