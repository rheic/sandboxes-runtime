+// TestTCPPolicyEvaluatesBeforeNAT pins the M0 ordering: policy decisions and
+// audit must see the guest-visible destination, not the host-NAT translation.
+func TestTCPPolicyEvaluatesBeforeNAT(t *testing.T) {
+	backend := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, "ok")
+	}))
+	defer backend.Close()
+	_, portString, err := net.SplitHostPort(backend.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	n, err := strconv.Atoi(portString)
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := uint16(n) //nolint:gosec // n is checked above.
+	policy := &types.EgressPolicy{Revision: "1", Allow: []types.EgressRule{{Protocol: "tcp", CIDR: "198.51.100.42/32", Port: port}}}
+	holder, err := types.NewEgressPolicyHolder(policy, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	s := stack.New(stack.Options{NetworkProtocols: []stack.NetworkProtocolFactory{ipv4.NewProtocol}, TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol}})
+	defer s.Close()
+	if e := s.CreateNIC(1, loopback.New()); e != nil {
+		t.Fatal(e)
+	}
+	source := tcpip.AddrFrom4([4]byte{10, 0, 2, 100})
+	if e := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv4.ProtocolNumber, AddressWithPrefix: source.WithPrefix()}, stack.AddressProperties{}); e != nil {
+		t.Fatal(e)
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	virtual := tcpip.AddrFrom4([4]byte{198, 51, 100, 42})
+	var mu sync.Mutex
+	fw := TCP(s, map[tcpip.Address]tcpip.Address{virtual: tcpip.AddrFrom4([4]byte{127, 0, 0, 1})}, &mu, false, 16, 2*time.Second, holder)
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, fw.HandlePacket)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	c, err := gonet.DialContextTCP(ctx, s, tcpip.FullAddress{NIC: 1, Addr: virtual, Port: port}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatalf("guest-visible CIDR rule must match before NAT: %v", err)
+	}
+	defer c.Close()
+	if e := holder.Update(&types.EgressPolicy{Revision: "2", Deny: []types.EgressRule{{Protocol: "tcp", CIDR: "198.51.100.42/32", Port: port}}}); e != nil {
+		t.Fatal(e)
+	}
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel2()
+	if _, err := gonet.DialContextTCP(ctx2, s, tcpip.FullAddress{NIC: 1, Addr: virtual, Port: port}, ipv4.ProtocolNumber); err == nil {
+		t.Fatal("guest-visible deny rule must reject before NAT")
+	}
+}
