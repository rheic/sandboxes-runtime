index 0000000..654b483
--- /dev/null
+++ b/pkg/services/forwarder/udp_proxy_policy_test.go
@@ -0,0 +1,166 @@
+package forwarder
+
+import (
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestUDPProxyAuthorizesFirstDatagramBeforeDial(t *testing.T) {
+	listener, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 0})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var dialCount atomic.Int32
+	var authorizedCount atomic.Int32
+	var cleanupCount atomic.Int32
+	peers := make(chan net.Conn, 1)
+	proxy, err := NewUDPProxy(listener, func(net.Addr) (net.Conn, error) {
+		dialCount.Add(1)
+		inside, outside := net.Pipe()
+		peers <- outside
+		return inside, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	proxy.SetFirstDatagramAuthorizer(func(packet []byte, _ net.Addr) (func(), bool) {
+		authorizedCount.Add(1)
+		if string(packet) != "authorized initial" {
+			return nil, false
+		}
+		return func() { cleanupCount.Add(1) }, true
+	})
+	done := make(chan struct{})
+	go func() { proxy.Run(); close(done) }()
+	client, err := net.DialUDP("udp", nil, listener.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if _, err := client.Write([]byte("denied")); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, func() bool { return authorizedCount.Load() == 1 })
+	if got := dialCount.Load(); got != 0 {
+		t.Fatalf("unauthorized datagram created %d outbound flows", got)
+	}
+	if _, err := client.Write([]byte("authorized initial")); err != nil {
+		t.Fatal(err)
+	}
+	var peer net.Conn
+	select {
+	case peer = <-peers:
+	case <-time.After(time.Second):
+		t.Fatal("authorized datagram did not create outbound flow")
+	}
+	defer peer.Close()
+	read := make(chan string, 1)
+	go func() { buf := make([]byte, 64); n, _ := peer.Read(buf); read <- string(buf[:n]) }()
+	select {
+	case got := <-read:
+		if got != "authorized initial" {
+			t.Fatalf("first forwarded datagram=%q", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("first datagram was not forwarded")
+	}
+	if _, err := client.Write([]byte("established flow")); err != nil {
+		t.Fatal(err)
+	}
+	go func() { buf := make([]byte, 64); n, _ := peer.Read(buf); read <- string(buf[:n]) }()
+	select {
+	case got := <-read:
+		if got != "established flow" {
+			t.Fatalf("follow-up datagram=%q", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("follow-up datagram was not forwarded")
+	}
+	if got := authorizedCount.Load(); got != 2 {
+		t.Fatalf("first-datagram authorizer called %d times, want denied + first allowed only", got)
+	}
+	_ = proxy.Close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("UDP proxy did not stop")
+	}
+	if got := cleanupCount.Load(); got != 1 {
+		t.Fatalf("authorization cleanup called %d times, want one", got)
+	}
+	if got := dialCount.Load(); got != 1 {
+		t.Fatalf("outbound flow count=%d want one", got)
+	}
+}
+
+func TestUDPProxyCloseRejectsAuthorizationInFlight(t *testing.T) {
+	listener, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 0})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var dialCount atomic.Int32
+	var cleanupCount atomic.Int32
+	proxy, err := NewUDPProxy(listener, func(net.Addr) (net.Conn, error) {
+		dialCount.Add(1)
+		inside, outside := net.Pipe()
+		_ = outside.Close()
+		return inside, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered := make(chan struct{})
+	continueAuthorization := make(chan struct{})
+	proxy.SetFirstDatagramAuthorizer(func([]byte, net.Addr) (func(), bool) {
+		close(entered)
+		<-continueAuthorization
+		return func() { cleanupCount.Add(1) }, true
+	})
+	done := make(chan struct{})
+	go func() { proxy.Run(); close(done) }()
+	client, err := net.DialUDP("udp", nil, listener.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if _, err := client.Write([]byte("initial")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("first datagram did not enter authorization")
+	}
+	if err := proxy.Close(); err != nil {
+		t.Fatal(err)
+	}
+	close(continueAuthorization)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("UDP proxy did not stop after Close")
+	}
+	if got := dialCount.Load(); got != 0 {
+		t.Fatalf("closed proxy dialed %d outbound flows", got)
+	}
+	if got := cleanupCount.Load(); got != 1 {
+		t.Fatalf("authorization cleanup called %d times, want one", got)
+	}
+}
+
+func waitFor(t *testing.T, predicate func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if predicate() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("condition not observed before deadline")
+}
+
+var _ io.Closer = (*UDPProxy)(nil)
