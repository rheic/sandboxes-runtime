+func TestIPv6EgressRulesAreAcceptedAndAmbiguousMappedPrefixesRejected(t *testing.T) {
+	cases := []struct {
+		name    string
+		policy  *EgressPolicy
+		wantErr bool
+	}{
+		{
+			name:   "IPv4 allow positive control",
+			policy: &EgressPolicy{Allow: []EgressRule{{Protocol: "tcp", CIDR: "0.0.0.0/0", Port: 443}}},
+		},
+		{
+			name:   "IPv6 allow accepted",
+			policy: &EgressPolicy{Allow: []EgressRule{{Protocol: "tcp", CIDR: "2001:db8::/32", Port: 443}}},
+		},
+		{
+			name:   "IPv6 deny accepted",
+			policy: &EgressPolicy{Deny: []EgressRule{{Protocol: "tcp", CIDR: "2001:db8::/32", Port: 443}}},
+		},
