index 0000000..1ca368c
--- /dev/null
+++ b/pkg/services/forwarder/quic/initial.go
@@ -0,0 +1,525 @@
+// Package quic parses the client Initial packet needed for fail-closed QUIC
+// SNI classification. It deliberately does not parse or authorize 0-RTT,
+// Retry, short-header, or unknown-version packets.
+package quic
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+const (
+	Version1           uint32 = 1
+	Version2           uint32 = 0x6b3343cf
+	MaxInitialDatagram        = 16 << 10
+	MaxCryptoBytes            = 64 << 10
+	MaxInitialPackets         = 32
+)
+
+var (
+	errMalformed = errors.New("malformed QUIC Initial")
+	v1Salt       = mustHex("38762cf7f55934b34d179ae6a4c80cadccbb7f0a")
+	v2Salt       = mustHex("0dede3def700a6db819381be6e269dcbf9bd2ed9")
+)
+
+type Initial struct {
+	Version      uint32
+	DCID         []byte
+	PacketNumber uint64
+	Crypto       []byte
+	Fragments    []CryptoFragment
+}
+
+type CryptoFragment struct {
+	Offset uint64
+	Data   []byte
+}
+
+var ErrIncompleteClientHello = errors.New("incomplete QUIC ClientHello")
+
+// InitialReassembler bounds per-connection CRYPTO state while the ClientHello
+// arrives across multiple authenticated Initial packets.
+type InitialReassembler struct {
+	version uint32
+	dcid    []byte
+	stream  []byte
+	present []bool
+	high    int
+	packets int
+}
+
+func (r *InitialReassembler) Add(initial Initial) (string, bool, error) {
+	if r == nil || len(initial.Fragments) == 0 || len(initial.DCID) == 0 {
+		return "", false, errMalformed
+	}
+	if r.packets >= MaxInitialPackets {
+		return "", false, errors.New("QUIC Initial packet limit exceeded")
+	}
+	if r.packets == 0 {
+		r.version = initial.Version
+		r.dcid = append([]byte(nil), initial.DCID...)
+		r.stream = make([]byte, MaxCryptoBytes)
+		r.present = make([]bool, MaxCryptoBytes)
+	} else if r.version != initial.Version || !equalBytes(r.dcid, initial.DCID) {
+		return "", false, errors.New("QUIC Initial connection identity changed")
+	}
+	r.packets++
+	for _, fragment := range initial.Fragments {
+		if fragment.Offset > MaxCryptoBytes || uint64(len(fragment.Data)) > MaxCryptoBytes-fragment.Offset {
+			return "", false, errMalformed
+		}
+		offset := int(fragment.Offset)
+		for i, value := range fragment.Data {
+			index := offset + i
+			if r.present[index] && r.stream[index] != value {
+				return "", false, errors.New("conflicting QUIC CRYPTO fragments")
+			}
+			r.stream[index] = value
+			r.present[index] = true
+		}
+		if end := offset + len(fragment.Data); end > r.high {
+			r.high = end
+		}
+	}
+	if r.high == 0 {
+		return "", false, errMalformed
+	}
+	for i := 0; i < r.high; i++ {
+		if !r.present[i] {
+			return "", false, nil
+		}
+	}
+	name, err := clientHelloSNI(r.stream[:r.high])
+	if errors.Is(err, ErrIncompleteClientHello) {
+		return "", false, nil
+	}
+	if err != nil {
+		return "", false, err
+	}
+	return name, true, nil
+}
+
+func equalBytes(a, b []byte) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ParseClientInitial authenticates and decrypts one complete client Initial
+// datagram, then returns its contiguous TLS ClientHello CRYPTO stream and SNI.
+// Coalesced packets are rejected so policy can never overlook a second packet.
+func ParseClientInitial(datagram []byte) (string, Initial, error) {
+	var result Initial
+	if len(datagram) < 7 || len(datagram) > MaxInitialDatagram {
+		return "", result, fmt.Errorf("datagram size: %w", errMalformed)
+	}
+	first := datagram[0]
+	if first&0x80 == 0 || first&0x40 == 0 { // long header and fixed bit
+		return "", result, errMalformed
+	}
+	version := binary.BigEndian.Uint32(datagram[1:5])
+	var initialType byte
+	switch version {
+	case Version1:
+		initialType = 0
+	case Version2:
+		initialType = 1
+	default:
+		return "", result, fmt.Errorf("unsupported QUIC version %#x", version)
+	}
+	if (first>>4)&3 != initialType {
+		return "", result, errors.New("QUIC long-header packet is not an Initial")
+	}
+	pos := 5
+	dcid, pos, err := takeCID(datagram, pos)
+	if err != nil {
+		return "", result, err
+	}
+	_, pos, err = takeCID(datagram, pos)
+	if err != nil {
+		return "", result, err
+	}
+	if len(dcid) < 8 || len(dcid) > 20 {
+		return "", result, errors.New("QUIC Initial DCID length outside policy bounds")
+	}
+	if version == Version1 || version == Version2 {
+		tokenLen, n, e := readVarint(datagram, pos)
+		if e != nil {
+			return "", result, e
+		}
+		pos += n
+		tokenLength, ok := boundedInt(tokenLen, MaxInitialDatagram)
+		if !ok || tokenLength > len(datagram)-pos {
+			return "", result, errMalformed
+		}
+		pos += tokenLength
+	}
+	packetLen, n, err := readVarint(datagram, pos)
+	if err != nil {
+		return "", result, err
+	}
+	pos += n
+	pnOffset := pos
+	packetLength, ok := boundedInt(packetLen, MaxInitialDatagram)
+	if !ok || packetLength > len(datagram)-pnOffset || pnOffset+4+16 > len(datagram) {
+		return "", result, fmt.Errorf("packet length %d at %d in %d: %w", packetLen, pnOffset, len(datagram), errMalformed)
+	}
+	end := pnOffset + packetLength
+	if end != len(datagram) {
+		return "", result, errors.New("coalesced or trailing QUIC packets are unsupported")
+	}
+	keys, err := deriveInitialKeys(version, dcid)
+	if err != nil {
+		return "", result, err
+	}
+	block, _ := aes.NewCipher(keys.hp)
+	var mask [aes.BlockSize]byte
+	block.Encrypt(mask[:], datagram[pnOffset+4:pnOffset+4+aes.BlockSize])
+	unprotectedFirst := first ^ (mask[0] & 0x0f)
+	pnLen := int(unprotectedFirst&3) + 1
+	if pnOffset+pnLen > end || packetLength < pnLen+16 {
+		return "", result, fmt.Errorf("packet number length: %w", errMalformed)
+	}
+	header := append([]byte(nil), datagram[:pnOffset+pnLen]...)
+	header[0] = unprotectedFirst
+	var truncatedPN uint64
+	for i, maskByte := range mask[1 : pnLen+1] {
+		header[pnOffset+i] ^= maskByte
+		truncatedPN = (truncatedPN << 8) | uint64(header[pnOffset+i])
+	}
+	pn := reconstructPacketNumber(truncatedPN, pnLen, 0)
+	blockAEAD, err := aes.NewCipher(keys.key)
+	if err != nil {
+		return "", result, err
+	}
+	aead, err := cipher.NewGCM(blockAEAD)
+	if err != nil {
+		return "", result, err
+	}
+	nonce := append([]byte(nil), keys.iv...)
+	for i := 0; i < 8; i++ {
+		//nolint:gosec // masking to one byte keeps the QUIC packet number encoding bounded.
+		nonce[len(nonce)-1-i] ^= byte((pn >> (8 * i)) & 0xff)
+	}
+	plain, err := aead.Open(nil, nonce, datagram[pnOffset+pnLen:end], header)
+	if err != nil {
+		return "", result, errors.New("QUIC Initial authentication failed")
+	}
+	cryptoFragments, err := cryptoStream(plain)
+	if err != nil {
+		return "", result, fmt.Errorf("parse Initial frames: %w", err)
+	}
+	result = Initial{Version: version, DCID: append([]byte(nil), dcid...), PacketNumber: pn, Fragments: cryptoFragments}
+	var reassembler InitialReassembler
+	name, complete, err := reassembler.Add(result)
+	if err != nil {
+		return "", result, fmt.Errorf("parse ClientHello: %w", err)
+	}
+	if !complete {
+		return "", result, ErrIncompleteClientHello
+	}
+	result.Crypto = append([]byte(nil), reassembler.stream[:reassembler.high]...)
+	return name, result, nil
+}
+
+type initialKeys struct{ key, iv, hp []byte }
+
+func deriveInitialKeys(version uint32, dcid []byte) (initialKeys, error) {
+	salt, label := v1Salt, "quic "
+	if version == Version2 {
+		salt, label = v2Salt, "quicv2 "
+	} else if version != Version1 {
+		return initialKeys{}, errors.New("unsupported QUIC version")
+	}
+	initial := hkdfExtract(salt, dcid)
+	secret := hkdfExpandLabel(initial, "client in", 32)
+	return initialKeys{key: hkdfExpandLabel(secret, label+"key", 16), iv: hkdfExpandLabel(secret, label+"iv", 12), hp: hkdfExpandLabel(secret, label+"hp", 16)}, nil
+}
+
+// reconstructPacketNumber recovers a truncated packet number relative to the
+// first packet expected on a new connection (zero). Retransmission sequences
+// require connection state and are intentionally outside this parser API.
+func reconstructPacketNumber(truncated uint64, pnLen int, expected uint64) uint64 {
+	window := uint64(1) << uint(pnLen*8)
+	half := window / 2
+	mask := window - 1
+	packetNumber := (expected &^ mask) | truncated
+	if packetNumber+half <= expected && packetNumber+window < (1<<62) {
+		packetNumber += window
+	} else if packetNumber > expected+half && packetNumber >= window {
+		packetNumber -= window
+	}
+	return packetNumber
+}
+
+func hkdfExtract(salt, ikm []byte) []byte {
+	h := hmac.New(sha256.New, salt)
+	_, _ = h.Write(ikm)
+	return h.Sum(nil)
+}
+func hkdfExpandLabel(secret []byte, label string, size int) []byte {
+	full := []byte("tls13 " + label)
+	if size < 0 || size > 0xffff || len(full) > 0xff {
+		return nil
+	}
+	info := make([]byte, 2+1+len(full)+1)
+	//nolint:gosec // size and label length were bounded to their TLS field widths above.
+	binary.BigEndian.PutUint16(info[:2], uint16(size))
+	//nolint:gosec // full length was bounded to one byte above.
+	info[2] = byte(len(full))
+	copy(info[3:], full)
+	var out, previous []byte
+	for counter := byte(1); len(out) < size; counter++ {
+		h := hmac.New(sha256.New, secret)
+		_, _ = h.Write(previous)
+		_, _ = h.Write(info)
+		_, _ = h.Write([]byte{counter})
+		previous = h.Sum(nil)
+		out = append(out, previous...)
+	}
+	return out[:size]
+}
+func takeCID(b []byte, pos int) ([]byte, int, error) {
+	if pos >= len(b) {
+		return nil, 0, errMalformed
+	}
+	n := int(b[pos])
+	pos++
+	if n > 20 || n > len(b)-pos {
+		return nil, 0, errMalformed
+	}
+	return b[pos : pos+n], pos + n, nil
+}
+func readVarint(b []byte, pos int) (uint64, int, error) {
+	if pos >= len(b) {
+		return 0, 0, errMalformed
+	}
+	n := 1 << ((b[pos] >> 6) & 3)
+	if n > len(b)-pos {
+		return 0, 0, errMalformed
+	}
+	v := uint64(b[pos] & 0x3f)
+	for _, x := range b[pos+1 : pos+n] {
+		v = (v << 8) | uint64(x)
+	}
+	return v, n, nil
+}
+func boundedInt(value uint64, maximum uint64) (int, bool) {
+	if value > maximum {
+		return 0, false
+	}
+	//nolint:gosec // callers provide a small protocol limit (16 KiB or 64 KiB) before conversion.
+	return int(value), true
+}
+
+func cryptoStream(plain []byte) ([]CryptoFragment, error) {
+	var fragments []CryptoFragment
+	frames := 0
+	for pos := 0; pos < len(plain); {
+		frames++
+		if frames > 4096 {
+			return nil, errMalformed
+		}
+		typ, n, e := readVarint(plain, pos)
+		if e != nil {
+			return nil, e
+		}
+		pos += n
+		switch typ {
+		case 0:
+			continue // PADDING is one zero byte.
+		case 1: // PING
+		case 2, 3: // ACK / ACK_ECN
+			largest, a, e := readVarint(plain, pos)
+			if e != nil {
+				return nil, e
+			}
+			pos += a
+			_, a, e = readVarint(plain, pos)
+			if e != nil {
+				return nil, e
+			}
+			pos += a
+			ranges, a, e := readVarint(plain, pos)
+			if e != nil || ranges > 256 {
+				return nil, errMalformed
+			}
+			pos += a
+			_, a, e = readVarint(plain, pos)
+			if e != nil {
+				return nil, e
+			}
+			pos += a
+			for i := uint64(0); i < ranges*2; i++ {
+				_, a, e = readVarint(plain, pos)
+				if e != nil {
+					return nil, e
+				}
+				pos += a
+			}
+			_ = largest
+			if typ == 3 {
+				for i := 0; i < 3; i++ {
+					_, a, e = readVarint(plain, pos)
+					if e != nil {
+						return nil, e
+					}
+					pos += a
+				}
+			}
+		case 6: // CRYPTO
+			off, a, e := readVarint(plain, pos)
+			if e != nil {
+				return nil, e
+			}
+			pos += a
+			ln, a, e := readVarint(plain, pos)
+			if e != nil {
+				return nil, e
+			}
+			pos += a
+			if off > MaxCryptoBytes || ln > MaxCryptoBytes-off {
+				return nil, errMalformed
+			}
+			length, _ := boundedInt(ln, MaxCryptoBytes)
+			if length > len(plain)-pos {
+				return nil, errMalformed
+			}
+			fragments = append(fragments, CryptoFragment{Offset: off, Data: append([]byte(nil), plain[pos:pos+length]...)})
+			pos += length
+		default:
+			return nil, fmt.Errorf("unsupported QUIC Initial frame %#x", typ)
+		}
+		if pos > len(plain) {
+			return nil, errMalformed
+		}
+	}
+	if len(fragments) == 0 {
+		return nil, errors.New("QUIC Initial has no CRYPTO data")
+	}
+	return fragments, nil
+}
+
+func clientHelloSNI(stream []byte) (string, error) {
+	if len(stream) < 4 {
+		return "", ErrIncompleteClientHello
+	}
+	if stream[0] != 1 {
+		return "", errors.New("QUIC Initial does not begin with ClientHello")
+	}
+	bodyLen := int(stream[1])<<16 | int(stream[2])<<8 | int(stream[3])
+	if bodyLen > MaxCryptoBytes-4 {
+		return "", errMalformed
+	}
+	if bodyLen+4 > len(stream) {
+		return "", ErrIncompleteClientHello
+	}
+	b := stream[4 : 4+bodyLen]
+	pos := 0
+	skip := func(n int) bool {
+		if n < 0 || n > len(b)-pos {
+			return false
+		}
+		pos += n
+		return true
+	}
+	if !skip(2+32) || pos >= len(b) {
+		return "", errMalformed
+	}
+	sid := int(b[pos])
+	pos++
+	if !skip(sid) || pos+2 > len(b) {
+		return "", errMalformed
+	}
+	cs := int(binary.BigEndian.Uint16(b[pos:]))
+	pos += 2
+	if cs == 0 || cs%2 != 0 || !skip(cs) || pos >= len(b) {
+		return "", errMalformed
+	}
+	comp := int(b[pos])
+	pos++
+	if comp == 0 || !skip(comp) || pos+2 > len(b) {
+		return "", errMalformed
+	}
+	extLen := int(binary.BigEndian.Uint16(b[pos:]))
+	pos += 2
+	if extLen != len(b)-pos {
+		return "", errMalformed
+	}
+	end := pos + extLen
+	var serverName string
+	for pos < end {
+		if pos+4 > end {
+			return "", errMalformed
+		}
+		typ := binary.BigEndian.Uint16(b[pos:])
+		ln := int(binary.BigEndian.Uint16(b[pos+2:]))
+		pos += 4
+		if ln > end-pos {
+			return "", errMalformed
+		}
+		ext := b[pos : pos+ln]
+		pos += ln
+		if typ == 0xfe0d {
+			return "", errors.New("ECH ClientHello is unsupported")
+		}
+		if typ != 0 {
+			continue
+		}
+		if len(ext) < 2 || int(binary.BigEndian.Uint16(ext)) != len(ext)-2 {
+			return "", errMalformed
+		}
+		i := 2
+		for i < len(ext) {
+			if i+3 > len(ext) {
+				return "", errMalformed
+			}
+			kind := ext[i]
+			n := int(binary.BigEndian.Uint16(ext[i+1:]))
+			i += 3
+			if n > len(ext)-i {
+				return "", errMalformed
+			}
+			if kind == 0 {
+				if serverName != "" || n == 0 {
+					return "", errMalformed
+				}
+				serverName = strings.ToLower(string(ext[i : i+n]))
+			}
+			i += n
+		}
+	}
+	if serverName == "" || len(serverName) > 253 || strings.ContainsAny(serverName, "\x00:/[] ") {
+		return "", errors.New("ClientHello has no valid SNI")
+	}
+	return serverName, nil
+}
+func mustHex(s string) []byte {
+	b := make([]byte, len(s)/2)
+	for i := range b {
+		var v byte
+		for j := 0; j < 2; j++ {
+			c := s[2*i+j]
+			v <<= 4
+			if c >= '0' && c <= '9' {
+				v |= c - '0'
+			} else if c >= 'a' && c <= 'f' {
+				v |= c - 'a' + 10
+			}
+		}
+		b[i] = v
+	}
+	return b
+}
