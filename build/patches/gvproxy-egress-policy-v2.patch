+package virtualnetwork
+
+import (
+	"net"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+func natAddress(value string) tcpip.Address {
+	return tcpip.AddrFromSlice(net.ParseIP(value).To16())
+}
+
+func TestParseNATTableIPv6HostServices(t *testing.T) {
+	configuration := &types.Configuration{NAT: map[string]string{
+		"192.168.127.254":     "127.0.0.1",
+		"fd72:6865:6963:1::2": "::1",
+		"::ffff:198.51.100.7": "127.0.0.1",
+		"not-an-address":      "127.0.0.1",
+		"192.168.127.253":     "also-not-an-address",
+	}}
+	table := parseNATTable(configuration)
+
+	tests := []struct {
+		name        string
+		source      string
+		destination string
+		want        bool
+	}{
+		{name: "IPv4 host mapping", source: "192.168.127.254", destination: "127.0.0.1", want: true},
+		{name: "IPv6 host mapping", source: "fd72:6865:6963:1::2", destination: "::1", want: true},
+		{name: "IPv4-mapped source normalizes to IPv4", source: "198.51.100.7", destination: "127.0.0.1", want: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			source, ok := parseNATAddress(test.source)
+			if !ok {
+				t.Fatalf("test source %q did not parse", test.source)
+			}
+			destination, ok := table[source]
+			if !ok {
+				if test.want {
+					t.Fatalf("missing NAT entry for %s", test.source)
+				}
+				return
+			}
+			wantDestination, _ := parseNATAddress(test.destination)
+			if !test.want {
+				t.Fatalf("unexpected NAT entry for %s", test.source)
+			}
+			if destination != wantDestination {
+				t.Fatalf("NAT destination=%s want %s", destination, wantDestination)
+			}
+		})
+	}
+
+	if len(table) != 3 {
+		t.Fatalf("translation table has %d entries, want 3 valid rows", len(table))
+	}
+	if _, ok := table[natAddress("not-an-address")]; ok {
+		t.Fatal("invalid source was inserted into the NAT table")
+	}
+	if _, ok := table[tcpip.AddrFrom4([4]byte{192, 168, 127, 253})]; ok {
+		t.Fatal("entry with invalid destination was inserted into the NAT table")
+	}
+}
+
+func TestParseNATTableIPv6IsDistinctFromIPv4(t *testing.T) {
+	configuration := &types.Configuration{NAT: map[string]string{
+		"192.168.127.254":     "127.0.0.1",
+		"fd72:6865:6963:1::2": "::1",
+	}}
+	table := parseNATTable(configuration)
+	if len(table) != 2 {
+		t.Fatalf("translation table has %d entries, want 2", len(table))
+	}
+	v6Source := tcpip.AddrFrom16Slice(net.ParseIP("fd72:6865:6963:1::2").To16())
+	if destination, ok := table[v6Source]; !ok || destination.String() != "::1" {
+		t.Fatalf("IPv6 NAT entry=%s ok=%v, want ::1", destination, ok)
+	}
+}
