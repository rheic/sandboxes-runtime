+func TestInitialReassemblerHandlesFragmentedClientHello(t *testing.T) {
+	_, parsed, err := ParseClientInitial(makeTestInitial(t, Version1, "fragmented.example.test"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cut := len(parsed.Crypto) / 2
+	reassembler := new(InitialReassembler)
+	first := Initial{Version: parsed.Version, DCID: parsed.DCID, Fragments: []CryptoFragment{{Offset: 0, Data: parsed.Crypto[:cut]}}}
+	if _, complete, err := reassembler.Add(first); err != nil || complete {
+		t.Fatalf("first fragment: complete=%t err=%v", complete, err)
+	}
+	second := Initial{Version: parsed.Version, DCID: parsed.DCID, Fragments: []CryptoFragment{{Offset: uint64(cut), Data: parsed.Crypto[cut:]}}}
+	name, complete, err := reassembler.Add(second)
+	if err != nil || !complete || name != "fragmented.example.test" {
+		t.Fatalf("reassembled ClientHello: name=%q complete=%t err=%v", name, complete, err)
