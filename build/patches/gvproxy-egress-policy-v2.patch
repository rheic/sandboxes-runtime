+		wantIP string
+		wantN  int
+	}{
+		{remote: "192.0.2.7:80", wantIP: "192.0.2.7", wantN: 4},
+		{remote: "[fd72:6865:6963::2]:443", wantIP: "fd72:6865:6963::2", wantN: 16},
