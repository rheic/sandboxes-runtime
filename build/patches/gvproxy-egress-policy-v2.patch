+	if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv6.ProtocolNumber, AddressWithPrefix: source.WithPrefix()}, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
