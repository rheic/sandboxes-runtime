+		t.Fatal("invalid lookup generations")
+	}
+	if !holder.CommitDNS("api.example.test", []net.IPAddr{{IP: net.ParseIP("192.0.2.2")}}, time.Minute, 4, newer) {
+		t.Fatal("new answer rejected")
+	}
+	if holder.CommitDNS("api.example.test", []net.IPAddr{{IP: net.ParseIP("192.0.2.1")}}, time.Minute, 4, old) {
+		t.Fatal("stale answer accepted")
+	}
+	if holder.AllowsDomain("192.0.2.1", 443, "api.example.test") || !holder.AllowsDomain("192.0.2.2", 443, "api.example.test") {
+		t.Fatal("stale response changed current binding")
+	}
+}
+
+func TestDNSRebindingRevokesActiveFlow(t *testing.T) {
+	holder, err := NewEgressPolicyHolder(&EgressPolicy{Allow: []EgressRule{{Protocol: "tcp", Domain: "api.example.test", Port: 443}}}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	first := holder.BeginDNS("api.example.test", 4)
+	if !holder.CommitDNS("api.example.test", []net.IPAddr{{IP: net.ParseIP("192.0.2.1")}}, time.Minute, 4, first) {
+		t.Fatal("initial DNS rejected")
+	}
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	if holder.TrackDomain("192.0.2.1", 443, "api.example.test", a) == 0 {
+		t.Fatal("initial flow rejected")
+	}
+	second := holder.BeginDNS("api.example.test", 4)
+	if !holder.CommitDNS("api.example.test", []net.IPAddr{{IP: net.ParseIP("192.0.2.2")}}, time.Minute, 4, second) {
+		t.Fatal("replacement DNS rejected")
+	}
+	if _, err := a.Write([]byte("x")); err == nil {
+		t.Fatal("old flow survived rebinding")
+	}
+	if holder.AllowsDomain("192.0.2.1", 443, "api.example.test") || !holder.AllowsDomain("192.0.2.2", 443, "api.example.test") {
+		t.Fatal("DNS replacement not enforced")
+	}
+}
+
+func TestDomainGlobLabelBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		pattern, name string
+		want          bool
+	}{
+		{"api?.example.test", "api1.example.test", true},
+		{"api?.example.test", "api.example.test", false},
+		{"api[!1].example.test", "api2.example.test", true},
+		{"api[!1].example.test", "api1.example.test", false},
+		{"api[!1]example.test", "api.example.test", false},
+		{"*.api?.example.test", "www.api1.example.test", true},
+		{"*.api?.example.test", "www.api.example.test", false},
+		{"**.example.test", "a..example.test", false},
+	} {
+		matcher, err := compileDomainRule(tc.pattern)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := matcher.MatchString(tc.name); got != tc.want {
+			t.Fatalf("%q on %q = %v, want %v", tc.pattern, tc.name, got, tc.want)
+		}
+	}
+	for _, bad := range []string{"api[.].example.test", "api[!.].example.test", "api[.example.test", "api].example.test", "api[!].example.test"} {
+		if _, err := compileDomainRule(bad); err == nil {
+			t.Fatalf("invalid pattern %q accepted", bad)
+		}
+	}
+}
+
+func FuzzCompileDomainRule(f *testing.F) {
+	f.Add("api?.example.test", "api1.example.test")
+	f.Add("api[!1].example.test", "api2.example.test")
+	f.Add("*.example.test", "host.example.test")
+	f.Add("api[.].example.test", "api.example.test")
+	f.Fuzz(func(t *testing.T, pattern, name string) {
+		if len(pattern) > 253 || len(name) > 253 {
+			t.Skip()
+		}
+		compiled, err := compileDomainRule(pattern)
+		if err != nil {
+			return
+		}
+		_ = compiled.MatchString(name)
+	})
+}
diff --git a/pkg/virtualnetwork/ipv6_publish_test.go b/pkg/virtualnetwork/ipv6_publish_test.go
