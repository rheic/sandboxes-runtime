+		got, err := tcpipAddress(1, test.remote)
+		if err != nil {
+			t.Fatalf("tcpipAddress(%q): %v", test.remote, err)
+		}
+		if got.Addr.String() != test.wantIP || got.Addr.Len() != test.wantN {
+			t.Fatalf("tcpipAddress(%q)=%+v", test.remote, got)
+		}
