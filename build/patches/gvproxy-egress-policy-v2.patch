+package dns
+
+import (
+	"net"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/miekg/dns"
+)
+
+func TestPolicyDNSUsesTTLChainAndConfiguredUpstream(t *testing.T) {
+	packet, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	mux := dns.NewServeMux()
+	mux.HandleFunc(".", func(w dns.ResponseWriter, q *dns.Msg) {
+		response := new(dns.Msg)
+		response.SetReply(q)
+		name := q.Question[0].Name
+		rr := func(text string) dns.RR {
+			out, e := dns.NewRR(text)
+			if e != nil {
+				panic(e)
+			}
+			return out
+		}
+		switch name {
+		case "api.example.test.":
+			if q.Question[0].Qtype == dns.TypeA {
+				response.Answer = []dns.RR{rr("api.example.test. 1 IN CNAME cdn.example.test."), rr("cdn.example.test. 30 IN A 192.0.2.4"), rr("irrelevant.example.test. 30 IN A 192.0.2.99")}
+			}
+			if q.Question[0].Qtype == dns.TypeAAAA {
+				response.Answer = []dns.RR{rr("api.example.test. 30 IN AAAA 2001:db8::4")}
+			}
+		case "zero.example.test.":
+			response.Answer = []dns.RR{rr("zero.example.test. 0 IN A 192.0.2.5")}
+		case "blocked.example.test.":
+			response.Answer = []dns.RR{rr("blocked.example.test. 30 IN CNAME secret.example.test."), rr("secret.example.test. 30 IN A 192.0.2.6")}
+		case "loop.example.test.":
+			response.Answer = []dns.RR{rr("loop.example.test. 30 IN CNAME next.example.test."), rr("next.example.test. 30 IN CNAME loop.example.test.")}
+		case "split.example.test.":
+			response.Answer = []dns.RR{rr("split.example.test. 30 IN CNAME target.example.test.")}
+		case "target.example.test.":
+			response.Answer = []dns.RR{rr("target.example.test. 30 IN A 192.0.2.7")}
+		case "slow.example.test.":
+			response.Answer = []dns.RR{rr("slow.example.test. 1 IN CNAME slow-target.example.test.")}
+		case "slow-target.example.test.":
+			time.Sleep(1200 * time.Millisecond)
+			response.Answer = []dns.RR{rr("slow-target.example.test. 30 IN A 192.0.2.8")}
+		default:
+			response.Rcode = dns.RcodeNameError
+		}
+		_ = w.WriteMsg(response)
+	})
+	srv := &dns.Server{PacketConn: packet, Handler: mux}
+	go func() { _ = srv.ActivateAndServe() }()
+	t.Cleanup(func() {
+		if e := srv.Shutdown(); e != nil {
+			t.Errorf("shutdown: %v", e)
+		}
+	})
+	holder, err := types.NewEgressPolicyHolder(&types.EgressPolicy{Allow: []types.EgressRule{{Protocol: "tcp", Domain: "*.example.test", Port: 443}}, Deny: []types.EgressRule{{Protocol: "tcp", Domain: "secret.example.test", Port: 443}}}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = holder.Close() })
+	h := &dnsHandler{policy: holder, allowUpstream: true, policyUpstream: packet.LocalAddr().String(), client: &dns.Client{Timeout: 2 * time.Second}}
+	ask := func(name string, typ uint16) *dns.Msg {
+		m := new(dns.Msg)
+		m.SetQuestion(name, typ)
+		h.addAnswers(m)
+		return m
+	}
+	m := ask("api.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeSuccess || len(m.Answer) != 2 || !holder.AllowsDomain("192.0.2.4", 443, "api.example.test") {
+		t.Fatalf("A result: rcode=%d answers=%v", m.Rcode, m.Answer)
+	}
+	if holder.AllowsDomain("192.0.2.99", 443, "api.example.test") {
+		t.Fatal("unrelated answer created a binding")
+	}
+	m = ask("api.example.test.", dns.TypeAAAA)
+	if m.Rcode != dns.RcodeSuccess || len(m.Answer) != 1 || !holder.AllowsDomain("2001:db8::4", 443, "api.example.test") || !holder.AllowsDomain("192.0.2.4", 443, "api.example.test") {
+		t.Fatalf("AAAA result: rcode=%d answers=%v", m.Rcode, m.Answer)
+	}
+	time.Sleep(1200 * time.Millisecond)
+	if holder.AllowsDomain("192.0.2.4", 443, "api.example.test") {
+		t.Fatal("CNAME TTL ignored")
+	}
+	m = ask("zero.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeSuccess || holder.AllowsDomain("192.0.2.5", 443, "zero.example.test") {
+		t.Fatal("zero TTL produced a binding")
+	}
+	m = ask("blocked.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeRefused || holder.AllowsDomain("192.0.2.6", 443, "blocked.example.test") {
+		t.Fatal("denied CNAME target accepted")
+	}
+	m = ask("loop.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeRefused {
+		t.Fatalf("CNAME loop rcode=%d", m.Rcode)
+	}
+	m = ask("split.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeSuccess || len(m.Answer) != 2 || !holder.AllowsDomain("192.0.2.7", 443, "split.example.test") {
+		t.Fatalf("split CNAME rcode=%d answers=%v", m.Rcode, m.Answer)
+	}
+	m = ask("slow.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeSuccess || holder.AllowsDomain("192.0.2.8", 443, "slow.example.test") {
+		t.Fatal("expired alias TTL was extended by subsequent lookup")
+	}
+	h.policyUpstream = ""
+	h.nameservers = []string{packet.LocalAddr().String()}
+	m = ask("api.example.test.", dns.TypeA)
+	if m.Rcode != dns.RcodeServerFailure || holder.AllowsDomain("192.0.2.4", 443, "api.example.test") {
+		t.Fatal("missing configured upstream did not fail closed")
+	}
+}
+
+func TestPolicyUpstreamReplacesFallback(t *testing.T) {
+	s := &Server{handler: &dnsHandler{nameservers: []string{"192.0.2.1:53"}}}
+	if err := s.SetPolicyUpstream("127.0.0.1:5300"); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.handler.nameservers) != 1 || s.handler.nameservers[0] != "127.0.0.1:5300" {
+		t.Fatal("system DNS remained configured")
+	}
+	if err := s.SetPolicyUpstream("invalid"); err == nil {
+		t.Fatal("invalid upstream accepted")
+	}
+}
+
+func TestPolicyDNSOutOfOrderResponsesFailClosed(t *testing.T) {
+	packet, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	started := make(chan struct{})
+	release := make(chan struct{})
+	var count atomic.Int32
+	mux := dns.NewServeMux()
+	mux.HandleFunc(".", func(w dns.ResponseWriter, q *dns.Msg) {
+		n := count.Add(1)
+		if n == 1 {
+			close(started)
+			<-release
+		}
+		m := new(dns.Msg)
+		m.SetReply(q)
+		ip := net.ParseIP("192.0.2.2")
+		if n == 1 {
+			ip = net.ParseIP("192.0.2.1")
+		}
+		m.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 30}, A: ip}}
+		_ = w.WriteMsg(m)
+	})
+	srv := &dns.Server{PacketConn: packet, Handler: mux}
+	go func() { _ = srv.ActivateAndServe() }()
+	t.Cleanup(func() {
+		if err := srv.Shutdown(); err != nil {
+			t.Errorf("shutdown: %v", err)
+		}
+	})
+	holder, err := types.NewEgressPolicyHolder(&types.EgressPolicy{Allow: []types.EgressRule{{Protocol: "tcp", Domain: "api.example.test", Port: 443}}}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	h := &dnsHandler{policy: holder, allowUpstream: true, policyUpstream: packet.LocalAddr().String(), client: &dns.Client{Timeout: 2 * time.Second}}
+	ask := func() *dns.Msg {
+		m := new(dns.Msg)
+		m.SetQuestion("api.example.test.", dns.TypeA)
+		h.addAnswers(m)
+		return m
+	}
+	old := make(chan *dns.Msg, 1)
+	go func() { old <- ask() }()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("first DNS query did not arrive")
+	}
+	fresh := ask()
+	close(release)
+	stale := <-old
+	if fresh.Rcode != dns.RcodeSuccess || stale.Rcode != dns.RcodeServerFailure {
+		t.Fatalf("fresh=%d stale=%d", fresh.Rcode, stale.Rcode)
+	}
+	if holder.AllowsDomain("192.0.2.1", 443, "api.example.test") || !holder.AllowsDomain("192.0.2.2", 443, "api.example.test") {
+		t.Fatal("stale DNS answer authorized")
+	}
+}
+
+func FuzzPolicyDNSAnswers(f *testing.F) {
+	seed := new(dns.Msg)
+	seed.SetQuestion("api.example.test.", dns.TypeA)
+	seed.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: "api.example.test.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 10}, A: net.ParseIP("192.0.2.1")}}
+	raw, err := seed.Pack()
+	if err != nil {
+		f.Fatal(err)
+	}
+	f.Add(raw)
+	f.Add([]byte{0, 1, 2, 3})
+	f.Fuzz(func(t *testing.T, data []byte) {
+		if len(data) > dns.MaxMsgSize {
+			t.Skip()
+		}
+		var msg dns.Msg
+		if err := msg.Unpack(data); err != nil {
+			return
+		}
+		for _, family := range []int{4, 6} {
+			alias, records, err := policyRRs(msg.Answer, "api.example.test.", family)
+			if err == nil && alias != nil && len(records) > 0 {
+				t.Fatal("CNAME and addresses accepted together")
+			}
+		}
+	})
+}
+
+func TestPolicyDNSTruncationRetriesOnlyConfiguredUpstream(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	packet, err := net.ListenPacket("udp", listener.Addr().String())
+	if err != nil {
+		listener.Close()
+		t.Fatal(err)
+	}
+	var udpQueries, tcpQueries atomic.Int32
+	mux := dns.NewServeMux()
+	mux.HandleFunc(".", func(w dns.ResponseWriter, q *dns.Msg) {
+		m := new(dns.Msg)
+		m.SetReply(q)
+		if strings.HasPrefix(w.RemoteAddr().Network(), "udp") {
+			udpQueries.Add(1)
+			if q.Question[0].Name == "tampered.example.test." {
+				m.Question[0].Name = "wrong.example.test."
+			}
+			m.Truncated = true
+		} else {
+			tcpQueries.Add(1)
+			if q.Question[0].Name == "truncated.example.test." {
+				m.Truncated = true
+			} else {
+				m.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 30}, A: net.ParseIP("192.0.2.20")}}
+			}
+		}
+		_ = w.WriteMsg(m)
+	})
+	udpServer := &dns.Server{PacketConn: packet, Handler: mux}
+	tcpServer := &dns.Server{Listener: listener, Handler: mux}
+	go func() { _ = udpServer.ActivateAndServe() }()
+	go func() { _ = tcpServer.ActivateAndServe() }()
+	t.Cleanup(func() {
+		if err := udpServer.Shutdown(); err != nil {
+			t.Errorf("udp cleanup: %v", err)
+		}
+		if err := tcpServer.Shutdown(); err != nil {
+			t.Errorf("tcp cleanup: %v", err)
+		}
+	})
+	holder, err := types.NewEgressPolicyHolder(&types.EgressPolicy{Allow: []types.EgressRule{{Protocol: "tcp", Domain: "*.example.test", Port: 443}}}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	h := &dnsHandler{policy: holder, allowUpstream: true, policyUpstream: listener.Addr().String(), nameservers: []string{"192.0.2.1:53"}, client: &dns.Client{Timeout: time.Second}}
+	ask := func(name string) *dns.Msg {
+		m := new(dns.Msg)
+		m.SetQuestion(name, dns.TypeA)
+		h.addAnswers(m)
+		return m
+	}
+	good := ask("api.example.test.")
+	if good.Rcode != dns.RcodeSuccess || !holder.AllowsDomain("192.0.2.20", 443, "api.example.test") {
+		t.Fatalf("TCP retry did not authorize: rcode=%d", good.Rcode)
+	}
+	bad := ask("truncated.example.test.")
+	if bad.Rcode != dns.RcodeServerFailure || holder.AllowsDomain("192.0.2.20", 443, "truncated.example.test") {
+		t.Fatal("truncated TCP answer accepted")
+	}
+	tampered := ask("tampered.example.test.")
+	if tampered.Rcode != dns.RcodeServerFailure {
+		t.Fatal("mismatched truncated question accepted")
+	}
+	if udpQueries.Load() != 3 || tcpQueries.Load() != 2 {
+		t.Fatalf("UDP=%d TCP=%d", udpQueries.Load(), tcpQueries.Load())
+	}
+}
diff --git a/pkg/services/forwarder/clienthello.go b/pkg/services/forwarder/clienthello.go
new file mode 100644
index 0000000..3c6a490
--- /dev/null
+++ b/pkg/services/forwarder/clienthello.go
@@ -0,0 +1,75 @@
+package forwarder
+
+import (
+	"bytes"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"time"
+)
+
+const maxClientHelloBytes = 64 << 10
+
+var errClientHelloCaptured = errors.New("client hello captured")
+
+type helloCaptureConn struct {
+	net.Conn
+	captured bytes.Buffer
+}
+
+func (c *helloCaptureConn) Read(p []byte) (int, error) {
+	remaining := maxClientHelloBytes - c.captured.Len()
+	if remaining <= 0 {
+		return 0, errors.New("client hello exceeds limit")
+	}
+	if len(p) > remaining {
+		p = p[:remaining]
+	}
+	n, err := c.Conn.Read(p)
+	_, _ = c.captured.Write(p[:n])
+	return n, err
+}
+
+func (c *helloCaptureConn) Write([]byte) (int, error) {
+	return 0, errors.New("unexpected TLS server response")
+}
+
+// readClientHello consumes a bounded TLS handshake prefix, without completing
+// TLS or writing to the client. The caller must replay the prefix unmodified.
+func readClientHello(conn net.Conn, timeout time.Duration) (string, []byte, error) {
+	if timeout <= 0 || timeout > 30*time.Second {
+		timeout = 30 * time.Second
+	}
+	if err := conn.SetReadDeadline(time.Now().Add(timeout)); err != nil {
+		return "", nil, fmt.Errorf("set hello deadline: %w", err)
+	}
+	defer func() { _ = conn.SetReadDeadline(time.Time{}) }()
+	capture := &helloCaptureConn{Conn: conn}
+	var name string
+	server := tls.Server(capture, &tls.Config{GetConfigForClient: func(hello *tls.ClientHelloInfo) (*tls.Config, error) {
+		for _, ext := range hello.Extensions {
+			if ext == 0xfe0d {
+				return nil, errors.New("encrypted client hello unsupported")
+			}
+		}
+		name = hello.ServerName
+		return nil, errClientHelloCaptured
+	}})
+	err := server.Handshake()
+	if !errors.Is(err, errClientHelloCaptured) {
+		return "", nil, fmt.Errorf("invalid TLS client hello: %w", err)
+	}
+	if name == "" {
+		return "", nil, errors.New("TLS client hello missing server name")
+	}
+	return name, bytes.Clone(capture.captured.Bytes()), nil
+}
+
+type replayConn struct {
+	net.Conn
+	reader io.Reader
+}
+
+func (c *replayConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
diff --git a/pkg/services/forwarder/clienthello_test.go b/pkg/services/forwarder/clienthello_test.go
new file mode 100644
index 0000000..ddaf742
--- /dev/null
+++ b/pkg/services/forwarder/clienthello_test.go
@@ -0,0 +1,105 @@
+package forwarder
+
+import (
+	"bytes"
+	"crypto/tls"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestReadClientHello(t *testing.T) {
+	client, proxy := net.Pipe()
+	defer client.Close()
+	defer proxy.Close()
+	finished := make(chan error, 1)
+	go func() {
+		finished <- tls.Client(client, &tls.Config{ServerName: "api.example.test", MinVersion: tls.VersionTLS12}).Handshake()
+	}()
+	name, prefix, err := readClientHello(proxy, time.Second)
+	if err != nil || name != "api.example.test" || len(prefix) == 0 {
+		t.Fatalf("readClientHello = %q, %d bytes, %v", name, len(prefix), err)
+	}
+	proxy.Close()
+	_ = <-finished
+}
+
+func TestReadClientHelloRejectsNonTLS(t *testing.T) {
+	client, proxy := net.Pipe()
+	defer client.Close()
+	defer proxy.Close()
+	go func() { _, _ = io.Copy(client, bytes.NewBufferString("GET / HTTP/1.0\r\n\r\n")); client.Close() }()
+	if _, _, err := readClientHello(proxy, time.Second); err == nil {
+		t.Fatal("accepted non-TLS input")
+	}
+}
+
+func TestReadClientHelloRejectsMissingSNI(t *testing.T) {
+	client, proxy := net.Pipe()
+	defer client.Close()
+	defer proxy.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = tls.Client(client, &tls.Config{ServerName: "127.0.0.1", MinVersion: tls.VersionTLS12}).Handshake()
+	}()
+	if _, _, err := readClientHello(proxy, time.Second); err == nil {
+		t.Fatal("accepted absent SNI")
+	}
+	proxy.Close()
+	<-done
+}
+
+func TestReadClientHelloTimeout(t *testing.T) {
+	client, proxy := net.Pipe()
+	defer client.Close()
+	defer proxy.Close()
+	if _, _, err := readClientHello(proxy, 10*time.Millisecond); err == nil {
+		t.Fatal("accepted stalled handshake")
+	}
+}
+
+func TestReplayConn(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	go func() { _, _ = b.Write([]byte("tail")); b.Close() }()
+	c := &replayConn{Conn: a, reader: io.MultiReader(bytes.NewReader([]byte("prefix")), a)}
+	got, err := io.ReadAll(c)
+	if err != nil || string(got) != "prefixtail" {
+		t.Fatalf("replay = %q, %v", got, err)
+	}
+}
+
+type memoryConn struct {
+	input  io.Reader
+	output bytes.Buffer
+}
+
+func (c *memoryConn) Read(p []byte) (int, error)       { return c.input.Read(p) }
+func (c *memoryConn) Write(p []byte) (int, error)      { return c.output.Write(p) }
+func (c *memoryConn) Close() error                     { return nil }
+func (c *memoryConn) LocalAddr() net.Addr              { return nil }
+func (c *memoryConn) RemoteAddr() net.Addr             { return nil }
+func (c *memoryConn) SetDeadline(time.Time) error      { return nil }
+func (c *memoryConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *memoryConn) SetWriteDeadline(time.Time) error { return nil }
+
+func FuzzReadClientHello(f *testing.F) {
+	capture := &memoryConn{input: bytes.NewReader(nil)}
+	_ = tls.Client(capture, &tls.Config{ServerName: "api.example.test", MinVersion: tls.VersionTLS12}).Handshake()
+	f.Add(bytes.Clone(capture.output.Bytes()))
+	f.Add([]byte("GET / HTTP/1.1\r\n\r\n"))
+	f.Add([]byte{0x16, 0x03, 0x03, 0xff, 0xff})
+	f.Fuzz(func(t *testing.T, input []byte) {
+		if len(input) > 2*maxClientHelloBytes {
+			t.Skip()
+		}
+		c := &memoryConn{input: bytes.NewReader(input)}
+		name, prefix, err := readClientHello(c, time.Second)
+		if err == nil && (name == "" || len(prefix) > maxClientHelloBytes || !bytes.HasPrefix(input, prefix)) {
+			t.Fatalf("invalid successful parse: name=%q prefix length=%d", name, len(prefix))
+		}
+	})
+}
diff --git a/pkg/services/forwarder/nat_ipv6_test.go b/pkg/services/forwarder/nat_ipv6_test.go
new file mode 100644
index 0000000..7e789e5
--- /dev/null
+++ b/pkg/services/forwarder/nat_ipv6_test.go
@@ -0,0 +1,220 @@
+package forwarder
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/loopback"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+)
+
+const (
+	testGuestIPv6Source  = "fd72:6865:6963::100"
+	testGuestIPv6Virtual = "fd72:6865:6963:1::2"
+)
+
+func testIPv6Address(value string) tcpip.Address {
+	return tcpip.AddrFrom16Slice(net.ParseIP(value).To16())
+}
+
+func testIPv6Stack(t *testing.T) *stack.Stack {
+	t.Helper()
+	s := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv6.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	t.Cleanup(s.Close)
+	if err := s.CreateNIC(1, loopback.New()); err != nil {
+		t.Fatal(err)
+	}
+	source := testIPv6Address(testGuestIPv6Source)
+	if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv6.ProtocolNumber, AddressWithPrefix: source.WithPrefix()}, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv6EmptySubnet, NIC: 1}})
+	return s
+}
+
+func testIPv6Policy(t *testing.T, protocol string, port uint16) *types.EgressPolicyHolder {
+	t.Helper()
+	holder, err := types.NewEgressPolicyHolder(&types.EgressPolicy{
+		Revision: "1",
+		Allow:    []types.EgressRule{{Protocol: protocol, CIDR: testGuestIPv6Virtual + "/128", Port: port}},
+	}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = holder.Close() })
+	return holder
+}
+
+func serveOneIPv6TCP(t *testing.T, payload string) (uint16, *atomic.Int32) {
+	t.Helper()
+	listener, err := net.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		t.Skipf("IPv6 loopback unavailable: %v", err)
+	}
+	t.Cleanup(func() { _ = listener.Close() })
+	var accepted atomic.Int32
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			accepted.Add(1)
+			buf := make([]byte, 4)
+			_, _ = io.ReadFull(conn, buf)
+			_, _ = io.WriteString(conn, payload)
+			_ = conn.Close()
+		}
+	}()
+	port := uint16(listener.Addr().(*net.TCPAddr).Port) //nolint:gosec // kernel-assigned port.
+	return port, &accepted
+}
+
+func dialGuestIPv6TCP(s *stack.Stack, port uint16, request string) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	conn, err := gonet.DialContextTCP(ctx, s, tcpip.FullAddress{NIC: 1, Addr: testIPv6Address(testGuestIPv6Virtual), Port: port}, ipv6.ProtocolNumber)
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err := io.WriteString(conn, request); err != nil {
+		return "", err
+	}
+	body, err := io.ReadAll(conn)
+	return string(body), err
+}
+
+// TestTCPIPv6NATDialsHostLoopback pins the explicit host-services mapping: a
+// guest-visible ULA outside the guest /64 is translated to host ::1, while the
+// allow/deny decision and audit stay on the pre-NAT guest address.
+func TestTCPIPv6NATDialsHostLoopback(t *testing.T) {
+	port, accepted := serveOneIPv6TCP(t, "nat-v6-ok")
+	holder := testIPv6Policy(t, "tcp", port)
+	s := testIPv6Stack(t)
+	var mu sync.Mutex
+	translation := map[tcpip.Address]tcpip.Address{
+		testIPv6Address(testGuestIPv6Virtual): testIPv6Address("::1"),
+	}
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, TCP(s, translation, &mu, false, 16, 500*time.Millisecond, holder).HandlePacket)
+
+	body, err := dialGuestIPv6TCP(s, port, "ping")
+	if err != nil || body != "nat-v6-ok" {
+		t.Fatalf("IPv6 NAT egress body=%q err=%v", body, err)
+	}
+	if got := accepted.Load(); got != 1 {
+		t.Fatalf("host fixture accepted %d flows, want 1", got)
+	}
+
+	if err := holder.Update(&types.EgressPolicy{Revision: "2", Deny: []types.EgressRule{{Protocol: "tcp", CIDR: testGuestIPv6Virtual + "/128", Port: port}}}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := dialGuestIPv6TCP(s, port, "ping"); err == nil {
+		t.Fatal("IPv6 deny rule did not block the NAT-translated destination")
+	}
+	if got := accepted.Load(); got != 1 {
+		t.Fatalf("denied IPv6 policy still dialed the host fixture: accepts=%d", got)
+	}
+}
+
+// TestTCPIPv6NATNegativeControl proves an absent mapping fails closed: the
+// guest-visible ULA is not dialed successfully even though policy allows it.
+func TestTCPIPv6NATNegativeControl(t *testing.T) {
+	port, accepted := serveOneIPv6TCP(t, "must-not-arrive")
+	holder := testIPv6Policy(t, "tcp", port)
+	s := testIPv6Stack(t)
+	var mu sync.Mutex
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, TCP(s, map[tcpip.Address]tcpip.Address{}, &mu, false, 16, 250*time.Millisecond, holder).HandlePacket)
+
+	if _, err := dialGuestIPv6TCP(s, port, "ping"); err == nil {
+		t.Fatal("guest-visible ULA without a NAT entry unexpectedly connected")
+	}
+	if got := accepted.Load(); got != 0 {
+		t.Fatalf("negative control reached the host fixture %d times", got)
+	}
+}
+
+// TestUDPIPv6NATDialsHostLoopback covers the UDP forwarder path: the v6 NAT
+// entry translates the guest destination to host ::1 before dialing.
+func TestUDPIPv6NATDialsHostLoopback(t *testing.T) {
+	server, err := net.ListenUDP("udp6", &net.UDPAddr{IP: net.ParseIP("::1"), Port: 0})
+	if err != nil {
+		t.Skipf("IPv6 loopback unavailable: %v", err)
+	}
+	t.Cleanup(func() { _ = server.Close() })
+	var received atomic.Int32
+	go func() {
+		buf := make([]byte, 64)
+		for {
+			n, addr, err := server.ReadFromUDP(buf)
+			if err != nil {
+				return
+			}
+			received.Add(1)
+			_, _ = server.WriteToUDP([]byte("udp-"+string(buf[:n])), addr)
+		}
+	}()
+	port := uint16(server.LocalAddr().(*net.UDPAddr).Port) //nolint:gosec // kernel-assigned port.
+	holder := testIPv6Policy(t, "udp", port)
+	s := testIPv6Stack(t)
+	var mu sync.Mutex
+	translation := map[tcpip.Address]tcpip.Address{
+		testIPv6Address(testGuestIPv6Virtual): testIPv6Address("::1"),
+	}
+	s.SetTransportProtocolHandler(udp.ProtocolNumber, UDP(s, translation, &mu, false, holder).HandlePacket)
+
+	conn, err := gonet.DialUDP(s, nil, &tcpip.FullAddress{NIC: 1, Addr: testIPv6Address(testGuestIPv6Virtual), Port: port}, ipv6.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err := conn.Write([]byte("v6-ok")); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 64)
+	n, err := conn.Read(buf)
+	if err != nil || string(buf[:n]) != "udp-v6-ok" {
+		t.Fatalf("IPv6 UDP NAT response=%q err=%v", buf[:n], err)
+	}
+	if got := received.Load(); got != 1 {
+		t.Fatalf("host UDP fixture received %d datagrams, want 1", got)
+	}
+
+	if err := holder.Update(&types.EgressPolicy{Revision: "2"}); err != nil {
+		t.Fatal(err)
+	}
+	denied, err := gonet.DialUDP(s, nil, &tcpip.FullAddress{NIC: 1, Addr: testIPv6Address(testGuestIPv6Virtual), Port: port}, ipv6.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer denied.Close()
+	_ = denied.SetDeadline(time.Now().Add(500 * time.Millisecond))
+	if _, err := denied.Write([]byte("denied")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := denied.Read(buf); err == nil {
+		t.Fatal("UDP IPv6 egress survived policy revocation")
+	}
+	if got := received.Load(); got != 1 {
+		t.Fatalf("denied IPv6 UDP still reached the host fixture: datagrams=%d", got)
+	}
+}
