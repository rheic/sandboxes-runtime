+func TestVirtioDiskSuffixUsesLinuxBase26Names(t *testing.T) {
+	tests := []struct {
+		index int
+		want  string
+	}{
+		{index: 0, want: "a"},
+		{index: 25, want: "z"},
+		{index: 26, want: "aa"},
+		{index: 27, want: "ab"},
+		{index: 51, want: "az"},
+		{index: 52, want: "ba"},
+		{index: 701, want: "zz"},
+		{index: 702, want: "aaa"},
+	}
+	for _, tt := range tests {
+		t.Run(fmt.Sprint(tt.index), func(t *testing.T) {
+			if got := virtioDiskSuffix(tt.index); got != tt.want {
+				t.Fatalf("virtioDiskSuffix(%d) = %q, want %q", tt.index, got, tt.want)
+			}
+		})
+	}
+	if got := virtioDiskSuffix(-1); got != "" {
+		t.Fatalf("virtioDiskSuffix(-1) = %q, want empty", got)
+	}
+
+	allocator := newDiskAllocator(1)
+	if got := allocator.Next(); got != "b" {
+		t.Fatalf("first disk after one reserved device = %q, want b", got)
+	}
+}
+
+func TestLinuxContainerBlockDiskCountLimit(t *testing.T) {
+	if err := validateLinuxContainerBlockDiskCount(24, 1); err != nil {
+		t.Fatalf("maximum supported container block disk count rejected: %v", err)
+	}
+	require.ErrorIs(t, validateLinuxContainerBlockDiskCount(25, 1), errdefs.ErrNotImplemented)
+}
