+	mountedMarker := filepath.Join(victim, "marker")
+	require.NoError(t, os.WriteFile(mountedMarker, []byte("MOUNT_PRESERVE"), 0o600))
+	require.Contains(t, ownedMounts(t, root, label), parent)
+
+	for _, tc := range []struct {
+		name   string
+		remove func(string) error
+	}{
+		{name: "removeTree", remove: removeTree},
+		{name: "atomicDelete", remove: atomicDelete},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := tc.remove(victim)
