+   limitations under the License.
+*/
+
+package v2
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// uniqueSuffix returns a short unique suffix for test resources.
+func uniqueSuffix(t *testing.T) string {
+	t.Helper()
+	var b [8]byte
+	_, err := rand.Read(b[:])
+	require.NoError(t, err)
+	return hex.EncodeToString(b[:])
+}
+
+// requireConfinedRemoval skips the test when the running kernel cannot
+// support removeTree's openat2(2) confinement.
+func requireConfinedRemoval(t *testing.T) {
+	t.Helper()
+	if ok, reason := openat2ConfineSupported(t.TempDir()); !ok {
+		if errors.Is(reason, unix.ENOSYS) || errors.Is(reason, unix.EINVAL) {
+			t.Skipf("skipping: kernel lacks required openat2(2) primitive: %v", reason)
+		}
+		t.Fatalf("openat2(2) capability probe failed unexpectedly: %v", reason)
+	}
+}
+
+// openat2ConfineSupported probes whether the kernel supports openat2(2)
+// with the resolve flags used by removeTree. A missing syscall or
+// unsupported flags are reported as unsupported, along with the errno.
+func openat2ConfineSupported(dir string) (bool, error) {
+	fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return false, err
+	}
+	defer unix.Close(fd)
+
+	_, err = unix.Openat2(fd, "rheic-confine-probe-missing", &unix.OpenHow{
+		Flags:   unix.O_PATH | unix.O_CLOEXEC,
+		Resolve: resolveConfine,
+	})
+	switch {
+	case err == nil:
+		return false, errors.New("unexpected success opening nonexistent path")
+	case errors.Is(err, unix.ENOENT):
+		return true, nil
+	default:
+		return false, err
+	}
+}
+
+// makeBundleTree creates a bundle-like directory tree: a nested directory
+// layout, regular files, a symlink pointing outside the tree and a
+// self-referential symlink. It returns the bundle path, the external work
+// directory and the marker file left outside the bundle.
+func makeBundleTree(t *testing.T, name string) (bundle, work, marker string) {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), name)
+	bundle = filepath.Join(dir, "bundle-"+uniqueSuffix(t))
+	work = filepath.Join(dir, "work-"+uniqueSuffix(t))
+
+	require.NoError(t, os.MkdirAll(filepath.Join(bundle, "rootfs", "nested"), 0o700))
+	require.NoError(t, os.MkdirAll(filepath.Join(work, "keep"), 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(bundle, "config.json"), []byte("{}"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(bundle, "rootfs", "nested", "file"), []byte("x"), 0o600))
+	marker = filepath.Join(work, "keep", "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("PRESERVE"), 0o600))
+	// The real bundle layout contains a work symlink pointing at the
+	// external work directory; add an escaping symlink and a cycle too.
+	require.NoError(t, os.Symlink(work, filepath.Join(bundle, "work")))
+	require.NoError(t, os.Symlink(filepath.Join(work, "keep"), filepath.Join(bundle, "rootfs", "escape")))
+	require.NoError(t, os.Symlink(bundle, filepath.Join(bundle, "self")))
+	return bundle, work, marker
+}
+
+func TestRemoveTreeBundleLikeTree(t *testing.T) {
+	requireConfinedRemoval(t)
+	bundle, work, marker := makeBundleTree(t, "plain")
+
+	require.NoError(t, removeTree(bundle))
+
+	if _, err := os.Lstat(bundle); !os.IsNotExist(err) {
+		t.Fatalf("bundle path should be gone, got %v", err)
+	}
+	// Symlinks must have been unlinked, not followed: everything outside
+	// the bundle tree must still be intact.
+	data, err := os.ReadFile(marker)
+	require.NoError(t, err)
+	require.Equal(t, "PRESERVE", string(data))
+	if _, err := os.Lstat(filepath.Join(work, "keep")); err != nil {
+		t.Fatalf("external work tree must be preserved: %v", err)
+	}
+}
+
+func TestAtomicDeleteRemovesHiddenTree(t *testing.T) {
