+// makeBundleTree creates a bundle-like directory tree: a nested directory
+// layout, regular files, a symlink pointing outside the tree and a
+// self-referential symlink. It returns the bundle path, the external work
+// directory and the marker file left outside the bundle.
+func makeBundleTree(t *testing.T, name string) (bundle, work, marker string) {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), name)
+	bundle = filepath.Join(dir, "bundle-"+uniqueSuffix(t))
+	work = filepath.Join(dir, "work-"+uniqueSuffix(t))
+
+	require.NoError(t, os.MkdirAll(filepath.Join(bundle, "rootfs", "nested"), 0o700))
+	require.NoError(t, os.MkdirAll(filepath.Join(work, "keep"), 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(bundle, "config.json"), []byte("{}"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(bundle, "rootfs", "nested", "file"), []byte("x"), 0o600))
+	marker = filepath.Join(work, "keep", "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("PRESERVE"), 0o600))
+	// The real bundle layout contains a work symlink pointing at the
+	// external work directory; add an escaping symlink and a cycle too.
+	require.NoError(t, os.Symlink(work, filepath.Join(bundle, "work")))
+	require.NoError(t, os.Symlink(filepath.Join(work, "keep"), filepath.Join(bundle, "rootfs", "escape")))
+	require.NoError(t, os.Symlink(bundle, filepath.Join(bundle, "self")))
+	return bundle, work, marker
+}
