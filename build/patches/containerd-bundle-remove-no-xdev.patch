+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v2
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// errUnsupportedTreeDeletion marks cleanup operations that cannot be performed
+// safely on this platform. It must never be replaced by an unmount or a
+// recursive-delete fallback.
+var errUnsupportedTreeDeletion = errors.New("safe tree deletion is unsupported on this platform")
+
+func unsupportedTreeOperation(operation, path string) error {
+	return fmt.Errorf("refusing to %s %q: %w", operation, path, errUnsupportedTreeDeletion)
+}
+
+// unsupportedUnlessAbsent allows idempotent cleanup of an already-missing
+// target. Any target that exists still fails closed without mutation.
+func unsupportedUnlessAbsent(operation, path string) error {
+	if _, err := os.Lstat(path); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+	return unsupportedTreeOperation(operation, path)
+}
+
+func verifyBundlePath(path string) error {
+	return unsupportedUnlessAbsent("delete bundle", path)
+}
+
+func verifyBundleRootfs(path string) error {
+	return unsupportedUnlessAbsent("delete bundle rootfs", path)
+}
+
+func verifyBundleWorkDir(path string) error {
+	return unsupportedUnlessAbsent("delete work directory", path)
+}
+
+// openNamespaceDir fails closed for an existing namespace directory on
+// platforms without the Linux pinned-parent opener.
+func openNamespaceDir(rootDir, ns string) (*os.File, error) {
+	path := filepath.Join(rootDir, ns)
+	if _, err := os.Lstat(path); err != nil {
+		return nil, err
+	}
+	return nil, unsupportedTreeOperation("enumerate work namespace", path)
+}
+
+// removeTree fails closed on platforms without the Linux safe traversal
+// implementation. It never removes descendants and never falls back to
+// os.RemoveAll.
+func removeTree(path string) error {
+	if _, err := os.Lstat(path); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+	return unsupportedTreeOperation("remove tree", path)
+}
+
+// removeRecoverableBundleTombstone fails closed on platforms without the
+// Linux mount-boundary preflight. It never falls back to a recursive delete.
+func removeRecoverableBundleTombstone(stateDir, ns, rootDir, id, name string) error {
+	return fmt.Errorf("refusing to remove hidden bundle %q: whole-tree mount preflight is unavailable on this platform", filepath.Join(stateDir, ns, name))
+}
+
+// atomicDeleteTree refuses before renaming. Renaming first and then failing
+// would either need a recursive delete (unsafe here) or leave a hidden
+// tombstone if restore also fails. Preserving the original path mutates no
+// descendants and keeps retries unambiguous.
+func atomicDeleteTree(path string) error {
+	if _, err := os.Lstat(path); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+	return unsupportedTreeOperation("delete tree atomically", path)
+}
