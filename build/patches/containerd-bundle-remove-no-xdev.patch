+// mountTestEnv gates the privileged bundle-mount integration test. It is
+// opt-in because it requires mount privileges (CAP_SYS_ADMIN).
+const mountTestEnv = "CONTAINERD_TEST_BUNDLE_MOUNT_REMOVAL"
+
+// TestRemoveTreeWithMountedDescendant creates a uniquely named tmpfs mount
+// beneath the bundle's rootfs and proves that cleanup fails closed before
+// mutating the bundle: the tmpfs marker, mount and config file survive. The
+// test then unmounts exactly the mount it created (matched by unique source
+// label and parent directory) and verifies removal succeeds.
+//
+// It skips when the environment is not opted in, when mount privileges are
+// unavailable, or when the kernel lacks the openat2(2) primitive.
+func TestRemoveTreeWithMountedDescendant(t *testing.T) {
+	if os.Getenv(mountTestEnv) != "1" {
+		t.Skipf("opt-in integration test: set %s=1 to run", mountTestEnv)
+	}
+	if os.Geteuid() != 0 {
+		t.Skip("skipping: mount privileges unavailable (requires root/CAP_SYS_ADMIN)")
+	}
+	// Resolve any symlinks in the temp root so paths can be compared
+	// against /proc/self/mountinfo, which reports canonical paths.
+	dir, err := filepath.EvalSymlinks(t.TempDir())
+	require.NoError(t, err)
+	requireConfinedRemoval(t)
+
+	bundleID := "rheic-mount-bundle-" + uniqueSuffix(t)
+	label := "rheic-tmpfs-" + uniqueSuffix(t)
+	bundle := filepath.Join(dir, bundleID)
+	rootfs := filepath.Join(bundle, "rootfs")
+	mountAt := filepath.Join(rootfs, "mnt")
+
+	require.NoError(t, os.MkdirAll(rootfs, 0o700))
+	require.NoError(t, os.MkdirAll(mountAt, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(bundle, "config.json"), []byte("{}"), 0o600))
+
+	// Uniquely owned tree: hand the whole bundle to a uid:gid that
+	// belongs to nothing else on the host, so anything this run creates
+	// (and anything that survives a failed cleanup) is attributable to
+	// this test alone.
+	uid, gid := uniqueOwner(t)
+	require.NoError(t, chownTree(bundle, uid, gid))
+
+	if err := unix.Mount(label, mountAt, "tmpfs", 0, "size=64k"); err != nil {
+		if errors.Is(err, unix.EPERM) || errors.Is(err, unix.EACCES) || errors.Is(err, unix.ENODEV) {
+			t.Skipf("skipping: mount privileges unavailable: %v", err)
+		}
+		t.Fatalf("failed to mount test tmpfs: %v", err)
+	}
+	// Ownership guarantee: cleanup only ever unmounts entries whose
+	// source label is ours and whose mountpoint is beneath our temp dir.
+	t.Cleanup(func() {
+		for _, mp := range ownedMounts(t, dir, label) {
+			detachOwnedMount(t, mp)
+		}
+	})
+
+	marker := filepath.Join(mountAt, "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("PRESERVE"), 0o600))
+	require.NoError(t, unix.Lchown(marker, uid, gid))
+	require.Contains(t, ownedMounts(t, dir, label), mountAt)
+
+	// Exercise Bundle.Delete itself. A rootfs mount must fail before any
+	// bundle entry is removed or any mount is detached.
+	ownedBundle := &Bundle{Path: bundle}
+	err = ownedBundle.Delete()
+	require.Error(t, err)
+	require.ErrorIs(t, err, errCrossMount)
+
+	// The rootfs preflight must leave the original bundle fully available.
+	atomicPath := filepath.Join(dir, "."+bundleID)
+	require.DirExists(t, bundle)
+	if _, err := os.Lstat(atomicPath); !os.IsNotExist(err) {
+		t.Fatalf("hidden atomic path should have been restored, got %v", err)
+	}
+	config, err := os.ReadFile(filepath.Join(bundle, "config.json"))
+	require.NoError(t, err, "bundle metadata must survive failed cleanup")
+	require.Equal(t, "{}", string(config))
+	mountedMarker := filepath.Join(mountAt, "marker")
+
+	// Mounted filesystem contents must be intact.
+	data, err := os.ReadFile(mountedMarker)
+	require.NoError(t, err, "marker inside mounted tmpfs must be preserved")
+	require.Equal(t, "PRESERVE", string(data))
+
+	// The marker must still carry this test run's unique ownership:
+	// nothing on the mounted filesystem was rewritten or replaced.
+	var st unix.Stat_t
+	require.NoError(t, unix.Lstat(mountedMarker, &st))
+	require.Equal(t, uint32(uid), st.Uid, "marker owner uid must be untouched")
+	require.Equal(t, uint32(gid), st.Gid, "marker owner gid must be untouched")
+
+	// The mount must still be present.
+	mounts := ownedMounts(t, dir, label)
+	require.Contains(t, mounts, mountAt)
+
+	// Owned unmount, then the confined removal must now succeed.
+	detachOwnedMount(t, mountAt)
+	require.NotContains(t, ownedMounts(t, dir, label), mountAt)
+	if _, err := os.Stat(mountedMarker); !os.IsNotExist(err) {
+		t.Fatalf("tmpfs marker should be gone after unmount, got %v", err)
+	}
+
+	require.NoError(t, ownedBundle.Delete())
+	if _, err := os.Lstat(bundle); !os.IsNotExist(err) {
+		t.Fatalf("bundle path should be gone, got %v", err)
+	}
+}
