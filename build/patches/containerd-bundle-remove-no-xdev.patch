+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v2
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// resolveConfine are the openat2(2) RESOLVE_* flags used to keep recursive
+// bundle removal descriptor-relative and confined to the target tree:
+// path resolution never leaves the directory file descriptor, symlinks and
+// magic links are never followed, and resolution never crosses into a
+// different mount.
+const resolveConfine = unix.RESOLVE_BENEATH |
+	unix.RESOLVE_NO_SYMLINKS |
+	unix.RESOLVE_NO_MAGICLINKS |
+	unix.RESOLVE_NO_XDEV
+
+// resolveStateRoot is used component by component while pinning the configured
+// state root. It rejects symlinks and magic links but intentionally allows a
+// mount transition, because the configured state path may legitimately cross
+// a trusted mount before the root is established. Once pinned, all namespace
+// and bundle entry lookups use resolveConfine, which also rejects xdev.
+const resolveStateRoot = unix.RESOLVE_BENEATH |
+	unix.RESOLVE_NO_SYMLINKS |
+	unix.RESOLVE_NO_MAGICLINKS
+
+var (
+	// errCrossMount is returned when the tree being removed contains a
+	// mountpoint. Removal fails closed: the mounted filesystem's contents
+	// are preserved and the caller must unmount first.
+	errCrossMount = errors.New("refusing to descend across mountpoint")
+
+	// errOpenat2Unsupported is returned when the running kernel does not
+	// support openat2(2) with the required resolve flags. Removal fails
+	// closed instead of falling back to a path-based recursive delete.
+	errOpenat2Unsupported = errors.New("openat2(2) resolve flags unsupported by kernel")
+)
+
+// direntBufSize is the getdents64(2) batch size used when walking a
+// directory. It is bounded by design; larger directories are read in
+// multiple batches.
+const direntBufSize = 8192
+
+// removalTestHook lets tests deterministically inject stat/open and
+// check/remove races. Production leaves it nil.
+var removalTestHook func(event string)
+
+func runRemovalTestHook(event string) {
+	if removalTestHook != nil {
+		removalTestHook(event)
+	}
+}
+
+func sameIdentity(a, b *unix.Stat_t) bool {
+	return a.Dev == b.Dev && a.Ino == b.Ino
+}
+
+func verifyOpenedIdentity(fd int, expected *unix.Stat_t, display string) error {
+	var opened unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstat(fd, &opened)
+	}); err != nil {
+		return fmt.Errorf("failed to stat opened entry %q: %w", display, err)
+	}
+	if !sameIdentity(expected, &opened) {
+		return fmt.Errorf("refusing to remove %q: opened inode changed", display)
+	}
+	return nil
+}
+
+func verifyNameIdentity(dirFD int, name, display string, expected *unix.Stat_t) error {
+	var current unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(dirFD, name, &current, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		return fmt.Errorf("refusing to remove %q: entry changed: %w", display, err)
+	}
+	if !sameIdentity(expected, &current) {
+		return fmt.Errorf("refusing to remove %q: inode changed", display)
+	}
+	return nil
+}
+
+// verifyBundlePath rejects every mount visible beneath the host-side bundle
+// before work or bundle entries are removed. Nerdbox mounts task rootfs inside
+// the guest; host-side mounts are not part of this runtime contract. Do not
+// unmount unknown mounts here: a mount boundary is a hard cleanup error.
+func verifyBundlePath(path string) error {
+	return verifyNoMounts(path)
+}
+
+// verifyBundleRootfs is retained for callers that only need the rootfs
+// preflight.
+func verifyBundleRootfs(path string) error {
+	return verifyNoMounts(path)
+}
+
+func verifyBundleWorkDir(path string) error {
+	return verifyNoMounts(path)
+}
+
+func verifyNoMounts(path string) error {
+	parentFD, err := openDir(filepath.Dir(path))
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	defer unix.Close(parentFD)
+
+	return verifyNoMountsAt(parentFD, filepath.Base(path), path)
+}
+
+func verifyNoMountsAt(parentFD int, name, display string) error {
+	var st unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(parentFD, name, &st, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("failed to stat rootfs path %q: %w", display, err)
+	}
+	entryFD, err := openEntryBeneath(parentFD, name)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("failed to inspect rootfs entry %q: %w", display, err)
+	}
+	defer unix.Close(entryFD)
+	if err := verifyOpenedIdentity(entryFD, &st, display); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return nil
+	}
+
+	childFD, err := openBeneath(parentFD, name)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("failed to inspect rootfs directory %q: %w", display, err)
+	}
+	defer unix.Close(childFD)
+	if err := verifyOpenedIdentity(childFD, &st, display); err != nil {
+		return err
+	}
+	return verifyDirNoMounts(childFD, display)
+}
+
+func verifyDirNoMounts(dirFD int, display string) error {
+	buf := make([]byte, direntBufSize)
+	for {
+		var n int
+		if err := retryEINTR(func() error {
+			var err error
+			n, err = unix.ReadDirent(dirFD, buf)
+			return err
+		}); err != nil {
+			return fmt.Errorf("failed to read rootfs directory %q: %w", display, err)
+		}
+		if n == 0 {
+			return nil
+		}
+		for off := 0; off < n; {
+			consumed, _, names := unix.ParseDirent(buf[off:n], -1, nil)
+			if consumed == 0 {
+				break
+			}
+			off += consumed
+			for _, entry := range names {
+				if err := verifyNoMountsAt(dirFD, string(entry), filepath.Join(display, string(entry))); err != nil {
+					return err
+				}
+			}
+		}
+	}
+}
+
+// removeTree removes the directory tree rooted at path.
+//
+// Every step of the traversal is resolved relative to an already-open
+// directory file descriptor via openat2(2) with resolveConfine, so the walk
+// cannot escape the tree through a symlink or magic link and cannot descend
+// across a mountpoint. If a descendant mount exists, or the kernel lacks
+// openat2(2) resolve-flag support, removeTree fails closed with an error and
+// leaves the mounted filesystem's contents intact.
+//
+// A missing path is not an error (matching os.RemoveAll behavior).
+func removeTree(path string) error {
+	pfd, err := openDir(filepath.Dir(path))
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	defer unix.Close(pfd)
+
+	return removeTreeAt(pfd, filepath.Base(path), path)
+}
+
+// removeRecoverableBundleTombstone removes an already-hidden bundle tree only
+// after anchoring every path lookup beneath the state root and passing the
+// whole-tree mount-boundary preflight. The namespace and hidden entry are
+// resolved through openat2(2) with resolveConfine, so an ancestor symlink or
+// mount cannot redirect recovery outside the trusted state root.
+//
+// The hidden entry is opened before the work link is read and its identity is
+// rechecked before the preflight and again before removal. It never renames
+// the tombstone and never unmounts anything.
+func removeRecoverableBundleTombstone(stateDir, ns, rootDir, id, name string) error {
+	rootFD, err := openStateRoot(stateDir)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(rootFD)
+
+	nsFD, err := openBeneath(rootFD, ns)
+	if err != nil {
+		return fmt.Errorf("failed to open namespace %q beneath %q: %w", ns, stateDir, err)
+	}
+	defer unix.Close(nsFD)
+
+	hiddenPath := filepath.Join(stateDir, ns, name)
+	originalPath := filepath.Join(stateDir, ns, id)
+
+	var st unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(nsFD, id, &st, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		if !errors.Is(err, unix.ENOENT) {
+			return fmt.Errorf("failed to inspect original path %q: %w", originalPath, err)
+		}
+	} else {
+		return fmt.Errorf("refusing to remove hidden bundle %q: original path %q exists", hiddenPath, originalPath)
+	}
+
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(nsFD, name, &st, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("failed to inspect hidden bundle %q: %w", hiddenPath, err)
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return fmt.Errorf("refusing to remove hidden bundle %q: hidden entry is not a bundle directory", hiddenPath)
+	}
+
+	hiddenFD, err := openBeneath(nsFD, name)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("refusing to open hidden bundle %q: %w", hiddenPath, err)
+	}
+	defer unix.Close(hiddenFD)
+
+	var opened unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstat(hiddenFD, &opened)
+	}); err != nil {
+		return fmt.Errorf("failed to stat opened hidden bundle %q: %w", hiddenPath, err)
+	}
+	if st.Dev != opened.Dev || st.Ino != opened.Ino {
+		return fmt.Errorf("refusing to remove hidden bundle %q: entry changed while opening", hiddenPath)
+	}
+
+	expectedWork := filepath.Join(rootDir, ns, id)
+	linkBuf := make([]byte, unix.PathMax)
+	var linkLen int
+	err = retryEINTR(func() error {
+		var readErr error
+		linkLen, readErr = unix.Readlinkat(hiddenFD, "work", linkBuf)
+		return readErr
+	})
+	switch {
+	case err == nil:
+		if linkLen == len(linkBuf) {
+			return fmt.Errorf("refusing to remove hidden bundle %q: work link target too long", hiddenPath)
+		}
+		if filepath.Clean(string(linkBuf[:linkLen])) != filepath.Clean(expectedWork) {
+			return fmt.Errorf("refusing to remove hidden bundle %q: unexpected work directory target %q", hiddenPath, string(linkBuf[:linkLen]))
+		}
+	case errors.Is(err, unix.ENOENT):
+		// A partially removed tombstone may no longer have the work link.
+	default:
+		return fmt.Errorf("refusing to remove hidden bundle %q: failed to inspect work link: %w", hiddenPath, err)
+	}
+
+	if err := sameHiddenEntry(nsFD, name, hiddenPath, &opened); err != nil {
+		return err
+	}
+	if err := verifyNoMountsAt(nsFD, name, hiddenPath); err != nil {
+		return fmt.Errorf("refusing to remove hidden bundle %q with mounted entry: %w", hiddenPath, err)
+	}
+	if err := sameHiddenEntry(nsFD, name, hiddenPath, &opened); err != nil {
+		return err
+	}
+	runRemovalTestHook("recoveryBeforeRemove")
+	return removeTreeAtWithIdentity(nsFD, name, hiddenPath, &opened)
+}
+
+// sameHiddenEntry verifies that name beneath dirFD still refers to the entry
+// opened as expected.
+func sameHiddenEntry(dirFD int, name, display string, expected *unix.Stat_t) error {
+	var current unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(dirFD, name, &current, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		return fmt.Errorf("refusing to remove hidden bundle %q: entry changed: %w", display, err)
+	}
+	if current.Dev != expected.Dev || current.Ino != expected.Ino {
+		return fmt.Errorf("refusing to remove hidden bundle %q: entry changed during recovery", display)
+	}
+	return nil
+}
+
+// atomicDeleteTree renames path to a hidden sibling and removes it while
+// keeping both names relative to one open parent descriptor. NOREPLACE avoids
+// overwriting stale hidden state or a path recreated during failure recovery.
+func atomicDeleteTree(path string) error {
+	parent := filepath.Dir(path)
+	pfd, err := openDir(parent)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	defer unix.Close(pfd)
+
+	name := filepath.Base(path)
+	source, err := statEntryAt(pfd, name, path)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+
+	atomicName := "." + name
+	err = retryEINTR(func() error {
+		return unix.Renameat2(pfd, name, pfd, atomicName, unix.RENAME_NOREPLACE)
+	})
+	if errors.Is(err, unix.ENOENT) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+
+	display := filepath.Join(parent, atomicName)
+	runRemovalTestHook("atomicAfterRename")
+
+	renamed, err := statEntryAt(pfd, atomicName, display)
+	if err != nil {
+		verifyErr := fmt.Errorf("failed to verify renamed entry %q: %w", display, err)
+		if restoreErr := restoreAtomicRename(pfd, atomicName, name, display, path); restoreErr != nil {
+			return errors.Join(verifyErr, restoreErr)
+		}
+		return verifyErr
+	}
+	if !sameIdentity(source, renamed) {
+		mismatchErr := fmt.Errorf("refusing to remove renamed entry %q: source inode changed", display)
+		if restoreErr := restoreAtomicRename(pfd, atomicName, name, display, path); restoreErr != nil {
+			return errors.Join(mismatchErr, restoreErr)
+		}
+		return mismatchErr
+	}
+
+	if err := removeTreeAtWithIdentity(pfd, atomicName, display, source); err != nil {
+		if restoreErr := restoreAtomicRename(pfd, atomicName, name, display, path); restoreErr != nil {
+			return errors.Join(err, restoreErr)
+		}
+		return err
+	}
+	return nil
+}
+
+func restoreAtomicRename(pfd int, from, to, display, path string) error {
+	if err := retryEINTR(func() error {
+		return unix.Renameat2(pfd, from, pfd, to, unix.RENAME_NOREPLACE)
+	}); err != nil {
+		return fmt.Errorf("failed to restore bundle from %q to %q after cleanup failure: %w", display, path, err)
+	}
+	return nil
+}
+
+// removeTreeAt removes a regular file, symlink, or directory entry beneath
+// parentFD without following symlinks or traversing mountpoints.
+func removeTreeAt(parentFD int, name, display string) error {
+	st, err := statEntryAt(parentFD, name, display)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	return removeTreeAtWithIdentity(parentFD, name, display, st)
+}
+
+// removeTreeAtWithIdentity removes only the entry that matched expected. It
+// rechecks the name before removal so recovery cannot delete a replacement.
+func removeTreeAtWithIdentity(parentFD int, name, display string, expected *unix.Stat_t) error {
+	if err := verifyNameIdentity(parentFD, name, display, expected); err != nil {
+		return err
+	}
+	if expected.Mode&unix.S_IFMT == unix.S_IFDIR {
+		return removeDirBeneathExpected(parentFD, name, display, expected)
+	}
+	return removeEntry(parentFD, name, 0, display)
+}
+
+func statEntryAt(parentFD int, name, display string) (*unix.Stat_t, error) {
+	var st unix.Stat_t
+	if err := retryEINTR(func() error {
+		return unix.Fstatat(parentFD, name, &st, unix.AT_SYMLINK_NOFOLLOW)
+	}); err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil, err
+		}
+		return nil, fmt.Errorf("failed to stat %q: %w", display, err)
+	}
+	return &st, nil
+}
+
+// openDir pins dir by resolving it to an absolute path and then walking every
+// component from / with openat2(2). Relative paths are first normalized with
+// filepath.Abs, which keeps them relative to the daemon CWD and cleans "..".
+// Absolute paths are used as-is.
+//
+// Ancestors may cross trusted mounts, so a mounted configured root remains
+// usable. The final parent component must resolve with RESOLVE_NO_XDEV relative
+// to its pinned parent. That rejects a mount placed directly over the
+// per-namespace parent while still allowing the configured root mount above it.
+func openDir(dir string) (int, error) {
+	abs, err := filepath.Abs(dir)
+	if err != nil {
+		return -1, fmt.Errorf("failed to resolve directory %q: %w", dir, err)
+	}
+	return openPinnedParent(abs)
+}
+
+// openPinnedParent resolves every component except the last with mount
+// crossings allowed, then requires the final component to stay on the pinned
+// parent's mount.
+func openPinnedParent(dir string) (int, error) {
+	if !filepath.IsAbs(dir) {
+		return -1, fmt.Errorf("refusing parent %q: path is not absolute", dir)
+	}
+	cleaned := filepath.Clean(dir)
+	var components []string
+	for _, component := range strings.Split(strings.TrimPrefix(cleaned, "/"), "/") {
+		if component != "" {
+			components = append(components, component)
+		}
+	}
+	if len(components) == 0 {
+		// "/" has no parent component to keep on one mount.
+		return openStateRoot(cleaned)
+	}
+
+	var rootFD int
+	if err := retryEINTR(func() error {
+		var err error
+		rootFD, err = unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		return err
+	}); err != nil {
+		return -1, fmt.Errorf("failed to open / while pinning parent %q: %w", cleaned, err)
+	}
+
+	current := rootFD
+	for i, component := range components {
+		if component == "." || component == ".." {
+			unix.Close(current)
+			return -1, fmt.Errorf("refusing parent %q: invalid path component %q", cleaned, component)
+		}
+		var (
+			next int
+			err  error
+		)
+		if i == len(components)-1 {
+			next, err = openFinalParentComponent(current, component, cleaned)
+		} else {
+			next, err = openStateRootComponent(current, component, cleaned)
+		}
+		unix.Close(current)
+		if err != nil {
+			return -1, err
+		}
+		current = next
+	}
+	return current, nil
+}
+
+// openFinalParentComponent opens the last component of a parent path without
+// crossing into another mount and without following symlinks or magic links.
+func openFinalParentComponent(dirfd int, name, display string) (int, error) {
+	var fd int
+	err := retryEINTR(func() error {
+		var err error
+		fd, err = unix.Openat2(dirfd, name, &unix.OpenHow{
+			Flags:   unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC,
+			Resolve: resolveConfine,
+		})
+		return err
+	})
+	switch {
+	case err == nil:
+		return fd, nil
+	case errors.Is(err, unix.EXDEV):
+		return -1, fmt.Errorf("refusing parent %q: final component %q is a mountpoint: %w: %w", display, name, err, errCrossMount)
+	case errors.Is(err, unix.ELOOP):
+		return -1, fmt.Errorf("refusing parent %q: component %q is a symlink or magic link: %w", display, name, err)
+	case errors.Is(err, unix.ENOSYS), errors.Is(err, unix.EINVAL):
+		return -1, fmt.Errorf("cannot verify parent confinement for %q: %w: %w", display, err, errOpenat2Unsupported)
+	default:
+		return -1, fmt.Errorf("failed to open final parent component %q of %q: %w", name, display, err)
+	}
+}
+
+// openNamespaceDir opens the per-namespace work directory using the same
+// pinned-parent rules as bundle/work deletion.
+func openNamespaceDir(rootDir, ns string) (*os.File, error) {
+	path := filepath.Join(rootDir, ns)
+	fd, err := openDir(path)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), path)
+	if f == nil {
+		unix.Close(fd)
+		return nil, fmt.Errorf("failed to create file for namespace directory %q", path)
+	}
+	return f, nil
+}
+
+// openStateRoot pins the configured state root by resolving it component by
+// component from / with openat2(2). Every component must be a real directory:
+// symlinks and magic links are rejected, including ancestors, while trusted
+// mount transitions are allowed. A relative configured path fails closed.
+func openStateRoot(dir string) (int, error) {
+	if !filepath.IsAbs(dir) {
+		return -1, fmt.Errorf("refusing state root %q: configured path is not absolute", dir)
+	}
+	cleaned := filepath.Clean(dir)
+
+	var rootFD int
+	if err := retryEINTR(func() error {
+		var err error
+		rootFD, err = unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		return err
+	}); err != nil {
+		return -1, fmt.Errorf("failed to open / while pinning state root %q: %w", cleaned, err)
+	}
+
+	current := rootFD
+	for _, component := range strings.Split(strings.TrimPrefix(cleaned, "/"), "/") {
+		if component == "" {
+			continue
+		}
+		if component == "." || component == ".." {
+			unix.Close(current)
+			return -1, fmt.Errorf("refusing state root %q: invalid path component %q", cleaned, component)
+		}
+		next, err := openStateRootComponent(current, component, cleaned)
+		unix.Close(current)
+		if err != nil {
+			return -1, err
+		}
+		current = next
+	}
+	return current, nil
+}
+
+// openStateRootComponent opens one real directory component beneath dirfd.
+// Mount crossings are permitted here; symlinks and magic links are not.
+func openStateRootComponent(dirfd int, name, display string) (int, error) {
+	var fd int
+	err := retryEINTR(func() error {
+		var err error
+		fd, err = unix.Openat2(dirfd, name, &unix.OpenHow{
+			Flags:   unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC,
+			Resolve: resolveStateRoot,
+		})
+		return err
+	})
+	switch {
+	case err == nil:
+		return fd, nil
+	case errors.Is(err, unix.ELOOP):
+		return -1, fmt.Errorf("refusing state root %q: component %q is a symlink or magic link: %w", display, name, err)
+	case errors.Is(err, unix.ENOSYS), errors.Is(err, unix.EINVAL):
+		return -1, fmt.Errorf("cannot verify state-root confinement for %q: %w: %w", display, err, errOpenat2Unsupported)
+	default:
+		return -1, fmt.Errorf("failed to open state-root component %q of %q: %w", name, display, err)
+	}
+}
+
+// openBeneath opens name strictly beneath dirfd, confined by resolveConfine.
+// Mountpoints surface as EXDEV and are reported as errCrossMount; kernels
+// without openat2(2) or resolve-flag support surface as ENOSYS/EINVAL and
+// are reported as errOpenat2Unsupported. Other errors are returned unwrapped
+// so callers can inspect the raw errno.
+func openBeneath(dirfd int, name string) (int, error) {
+	var fd int
+	err := retryEINTR(func() error {
+		var err error
+		fd, err = unix.Openat2(dirfd, name, &unix.OpenHow{
+			Flags:   unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC,
+			Resolve: resolveConfine,
+		})
+		return err
+	})
+	switch {
+	case err == nil:
+		return fd, nil
+	case errors.Is(err, unix.EXDEV):
+		return -1, fmt.Errorf("%q is a mountpoint (or resolution crossed one): %w: %w", name, err, errCrossMount)
+	case errors.Is(err, unix.ENOSYS), errors.Is(err, unix.EINVAL):
+		return -1, fmt.Errorf("cannot verify removal confinement for %q: %w: %w", name, err, errOpenat2Unsupported)
+	default:
+		return -1, err
+	}
+}
+
+// openEntryBeneath opens any final entry, including a symlink itself, without
+// following it or crossing a mountpoint. O_PATH lets the preflight detect
+// file bind mounts as well as directory mounts before cleanup mutates siblings.
+func openEntryBeneath(dirfd int, name string) (int, error) {
+	var fd int
+	err := retryEINTR(func() error {
+		var err error
+		fd, err = unix.Openat2(dirfd, name, &unix.OpenHow{
+			Flags:   unix.O_PATH | unix.O_CLOEXEC | unix.O_NOFOLLOW,
+			Resolve: resolveConfine,
+		})
+		return err
+	})
+	switch {
+	case err == nil:
+		return fd, nil
+	case errors.Is(err, unix.EXDEV):
+		return -1, fmt.Errorf("%q is a mountpoint (or resolution crossed one): %w: %w", name, err, errCrossMount)
+	case errors.Is(err, unix.ENOSYS), errors.Is(err, unix.EINVAL):
+		return -1, fmt.Errorf("cannot verify removal confinement for %q: %w: %w", name, err, errOpenat2Unsupported)
+	default:
+		return -1, err
+	}
+}
+
+// removeDirBeneath recursively removes the directory name beneath dirfd,
+// displaying path prefix display in errors.
+func removeDirBeneath(dirfd int, name, display string) error {
+	st, err := statEntryAt(dirfd, name, display)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	return removeDirBeneathExpected(dirfd, name, display, st)
+}
+
+// removeDirBeneathExpected removes the directory only while the name and the
+// opened descriptor still refer to expected. The identity check happens both
+// before opening and before the final recursive drain/unlink.
+func removeDirBeneathExpected(dirfd int, name, display string, expected *unix.Stat_t) error {
+	if err := verifyNameIdentity(dirfd, name, display, expected); err != nil {
+		return err
+	}
+	runRemovalTestHook("dirBeforeOpen")
+	cfd, err := openBeneath(dirfd, name)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return fmt.Errorf("failed to open %q: %w", display, err)
+	}
+	defer unix.Close(cfd)
+	if err := verifyOpenedIdentity(cfd, expected, display); err != nil {
+		return err
+	}
+	runRemovalTestHook("dirAfterOpen")
+
+	// The final unlinkat may race with entries appearing after the last
+	// getdents batch (or being missed due to offset reuse). Rescan a
+	// bounded number of times from the start of the directory before
+	// failing closed.
+	const maxScans = 4
+	for scan := range maxScans {
+		if err := drainDir(cfd, display); err != nil {
+			return err
+		}
+		if err := verifyNameIdentity(dirfd, name, display, expected); err != nil {
+			return err
+		}
+		err := retryEINTR(func() error {
+			return unix.Unlinkat(dirfd, name, unix.AT_REMOVEDIR)
+		})
+		switch {
+		case err == nil, errors.Is(err, unix.ENOENT):
+			return nil
+		case errors.Is(err, unix.ENOTEMPTY) && scan+1 < maxScans:
+			if seekErr := retryEINTR(func() error {
+				_, err := unix.Seek(cfd, 0, io.SeekStart)
+				return err
+			}); seekErr != nil {
+				return fmt.Errorf("failed to rewind directory %q: %w", display, seekErr)
+			}
+		default:
+			return fmt.Errorf("failed to remove directory %q: %w", display, err)
+		}
+	}
+	return fmt.Errorf("failed to remove directory %q: contents keep reappearing, giving up", display)
+}
+
+// drainDir removes every child entry visible from dirfd.
+func drainDir(dirfd int, display string) error {
+	buf := make([]byte, direntBufSize)
+	for {
+		var n int
+		err := retryEINTR(func() error {
+			var err error
+			n, err = unix.ReadDirent(dirfd, buf)
+			return err
+		})
+		if err != nil {
+			return fmt.Errorf("failed to read directory %q: %w", display, err)
+		}
+		if n == 0 {
+			return nil
+		}
+		for off := 0; off < n; {
+			consumed, _, names := unix.ParseDirent(buf[off:n], -1, nil)
+			if consumed == 0 {
+				break
+			}
+			off += consumed
+			for _, name := range names {
+				if err := removeChild(dirfd, display, string(name)); err != nil {
+					return err
+				}
+			}
+		}
+	}
+}
+
+// removeChild removes one entry of dirfd, recursing into directories
+// through a confined openat2 descriptor. Symlinks are unlinked, never
+// followed or opened.
+func removeChild(dirfd int, display, name string) error {
+	child := filepath.Join(display, name)
+
+	st, err := statEntryAt(dirfd, name, child)
+	if err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	if st.Mode&unix.S_IFMT == unix.S_IFDIR {
+		return removeDirBeneathExpected(dirfd, name, child, st)
+	}
+	return removeEntry(dirfd, name, 0, child)
+}
+
+func removeEntry(dirfd int, name string, flags int, display string) error {
+	err := retryEINTR(func() error {
+		return unix.Unlinkat(dirfd, name, flags)
+	})
+	switch {
+	case err == nil, errors.Is(err, unix.ENOENT):
+		return nil
+	case errors.Is(err, unix.EISDIR) && flags == 0:
+		// Became a directory mid-race: let the caller's confinement
+		// checks handle it rather than unlinking blindly.
+		return removeDirBeneath(dirfd, name, display)
+	default:
+		return fmt.Errorf("failed to remove %q: %w", display, err)
+	}
+}
+
+// retryEINTR runs fn until it finishes with an error other than EINTR.
+func retryEINTR(fn func() error) error {
+	for {
+		err := fn()
+		if !errors.Is(err, unix.EINTR) {
+			return err
+		}
+	}
+}
