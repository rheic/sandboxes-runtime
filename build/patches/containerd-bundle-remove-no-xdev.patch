+)
+
+func TestUnsupportedBundleDeletePreservesPopulatedData(t *testing.T) {
+	root := t.TempDir()
+	bundlePath := filepath.Join(root, "bundle")
+	workPath := filepath.Join(root, "work")
+	require.NoError(t, os.MkdirAll(filepath.Join(bundlePath, "rootfs"), 0o700))
+	require.NoError(t, os.MkdirAll(workPath, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(bundlePath, "config.json"), []byte(`{"keep":true}`), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(bundlePath, "rootfs", "rootfs-data"), []byte("ROOTFS"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(workPath, "work-data"), []byte("WORK"), 0o600))
+	require.NoError(t, os.Symlink(workPath, filepath.Join(bundlePath, "work")))
+
+	bundle := &Bundle{Path: bundlePath, workPath: workPath}
+	require.ErrorIs(t, bundle.Delete(), errUnsupportedTreeDeletion)
+
+	for path, want := range map[string]string{
+		filepath.Join(bundlePath, "config.json"):           `{"keep":true}`,
+		filepath.Join(bundlePath, "rootfs", "rootfs-data"): "ROOTFS",
+		filepath.Join(workPath, "work-data"):               "WORK",
+	} {
+		data, err := os.ReadFile(path)
+		require.NoError(t, err)
+		require.Equal(t, want, string(data))
+	}
+	target, err := os.Readlink(filepath.Join(bundlePath, "work"))
+	require.NoError(t, err)
+	require.Equal(t, workPath, target)
+	if _, err := os.Lstat(filepath.Join(root, ".bundle")); !os.IsNotExist(err) {
+		t.Fatalf("bundle delete must not create a hidden tombstone, got %v", err)
+	}
+	if _, err := os.Lstat(filepath.Join(root, ".work")); !os.IsNotExist(err) {
+		t.Fatalf("bundle delete must not create a hidden work tombstone, got %v", err)
+	}
+
+	require.ErrorIs(t, removeTree(workPath), errUnsupportedTreeDeletion)
+	require.ErrorIs(t, atomicDelete(bundlePath), errUnsupportedTreeDeletion)
+	require.FileExists(t, filepath.Join(workPath, "work-data"))
+	require.FileExists(t, filepath.Join(bundlePath, "config.json"))
+	if _, err := os.Lstat(filepath.Join(root, ".bundle")); !os.IsNotExist(err) {
+		t.Fatalf("atomic delete must preserve the original entry, got %v", err)
+	}
+}
+
+func TestUnsupportedAbsentDeleteIsIdempotent(t *testing.T) {
+	root := t.TempDir()
+	bundlePath := filepath.Join(root, "absent-bundle")
+	workPath := filepath.Join(root, "absent-work")
+	bundle := &Bundle{Path: bundlePath, workPath: workPath}
+
+	require.NoError(t, bundle.Delete())
+	require.NoError(t, bundle.Delete(), "repeated delete of an absent bundle must succeed")
+
+	for _, path := range []string{bundlePath, workPath} {
+		require.NoError(t, removeTree(path))
+		require.NoError(t, atomicDelete(path))
+		if _, err := os.Lstat(path); !os.IsNotExist(err) {
+			t.Fatalf("absent path %q should remain absent, got %v", path, err)
+		}
+	}
+	if _, err := os.Lstat(filepath.Join(root, ".absent-bundle")); !os.IsNotExist(err) {
+		t.Fatalf("absent bundle must not create a hidden tombstone, got %v", err)
+	}
+	if _, err := os.Lstat(filepath.Join(root, ".absent-work")); !os.IsNotExist(err) {
+		t.Fatalf("absent work must not create a hidden tombstone, got %v", err)
+	}
+}
+
+func TestUnsupportedDeletePreservesUninspectablePath(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "uninspectable")
+	marker := filepath.Join(path, "marker")
+	require.NoError(t, os.MkdirAll(path, 0o700))
+	require.NoError(t, os.WriteFile(marker, []byte("PRESERVE"), 0o600))
+	require.NoError(t, os.Chmod(path, 0))
+	t.Cleanup(func() { _ = os.Chmod(path, 0o700) })
+
+	require.ErrorIs(t, removeTree(path), errUnsupportedTreeDeletion)
+	require.ErrorIs(t, atomicDelete(path), errUnsupportedTreeDeletion)
+
+	if _, err := os.Lstat(path); err != nil {
+		t.Fatalf("uninspectable path must remain present: %v", err)
+	}
+	if _, err := os.Lstat(filepath.Join(root, ".uninspectable")); !os.IsNotExist(err) {
+		t.Fatalf("unsupported atomic delete must not rename the path, got %v", err)
+	}
+	require.NoError(t, os.Chmod(path, 0o700))
+	data, err := os.ReadFile(marker)
+	require.NoError(t, err)
+	require.Equal(t, "PRESERVE", string(data))
+}
