+// TestCleanupWorkDirsRejectsMountedWorkTree verifies the startup recovery
+// caller also refuses to remove an orphan work directory containing a mount.
+func TestCleanupWorkDirsRejectsMountedWorkTree(t *testing.T) {
+	if os.Getenv(mountTestEnv) != "1" {
+		t.Skipf("opt-in integration test: set %s=1 to run", mountTestEnv)
+	}
+	if os.Geteuid() != 0 {
+		t.Skip("skipping: mount privileges unavailable (requires root/CAP_SYS_ADMIN)")
+	}
+	requireConfinedRemoval(t)
+
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	require.NoError(t, err)
+	ns := "rheic-cleanup-" + uniqueSuffix(t)
+	id := "orphan-" + uniqueSuffix(t)
+	label := "rheic-work-tmpfs-" + uniqueSuffix(t)
+	workDir := filepath.Join(root, ns, id)
+	mountAt := filepath.Join(workDir, "mnt")
+	require.NoError(t, os.MkdirAll(mountAt, 0o700))
+	if err := unix.Mount(label, mountAt, "tmpfs", 0, "size=64k"); err != nil {
+		if errors.Is(err, unix.EPERM) || errors.Is(err, unix.EACCES) || errors.Is(err, unix.ENODEV) {
+			t.Skipf("skipping: mount privileges unavailable: %v", err)
+		}
+		t.Fatalf("failed to mount test tmpfs: %v", err)
+	}
+	t.Cleanup(func() {
+		for _, mp := range ownedMounts(t, root, label) {
+			detachOwnedMount(t, mp)
+		}
+	})
+	marker := filepath.Join(mountAt, "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("PRESERVE"), 0o600))
+
+	ctx := namespaces.WithNamespace(context.Background(), ns)
+	manager := &ShimManager{shims: runtimeapi.NewNSMap[ShimInstance]()}
+	require.NoError(t, manager.cleanupWorkDirs(ctx, root))
+	require.DirExists(t, workDir)
+	data, err := os.ReadFile(marker)
+	require.NoError(t, err)
+	require.Equal(t, "PRESERVE", string(data))
+	require.Contains(t, ownedMounts(t, root, label), mountAt)
+
+	detachOwnedMount(t, mountAt)
+	require.NoError(t, manager.cleanupWorkDirs(ctx, root))
+	_, err = os.Lstat(workDir)
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
