+   limitations under the License.
+*/
+
+package v2
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/containerd/errdefs"
+	"github.com/containerd/log"
+
+	"github.com/containerd/containerd/v2/pkg/identifiers"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+)
+
+// hiddenBundleTombstoneID reports whether name is exactly the hidden sibling
+// name produced by atomicDeleteTree for a valid bundle ID. Bundle IDs are
+// validated by NewBundle, and identifiers.Validate rejects a leading dot, so a
+// hidden name can never also be a live bundle name.
+func hiddenBundleTombstoneID(name string) (string, bool) {
+	if len(name) < 2 || name[0] != '.' {
+		return "", false
+	}
+	id := name[1:]
+	if err := identifiers.Validate(id); err != nil {
+		return "", false
+	}
+	return id, true
+}
+
+// recoverStaleBundleTombstone removes a hidden bundle state directory left by
+// an interrupted or failed atomicDeleteTree only when it can prove that no
+// live owner can still refer to it.
+//
+// The recovery is deliberately fail-closed. Any ambiguity, lookup failure, or
+// mount boundary leaves the hidden tree exactly where it is and returns an
+// error. It never unmounts anything and never touches the working directory.
+func (m *ShimManager) recoverStaleBundleTombstone(ctx context.Context, stateDir, rootDir, name string) error {
+	id, ok := hiddenBundleTombstoneID(name)
+	if !ok {
+		return nil
+	}
+
+	ns, err := namespaces.NamespaceRequired(ctx)
+	if err != nil {
+		return err
+	}
+
+	// Ownership cannot be proven without these records. Refuse rather than
+	// guessing that an entry is stale.
+	if m.containers == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: container store unavailable", name)
+	}
+	if m.sandboxStore == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: sandbox store unavailable", name)
+	}
+	if m.shims == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: shim registry unavailable", name)
+	}
+
+	bundlePath := filepath.Join(stateDir, ns, id)
+	if _, err := os.Lstat(bundlePath); err == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: original path %q exists", name, bundlePath)
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("refusing to recover hidden bundle %q: failed to inspect original path %q: %w", name, bundlePath, err)
+	}
+
+	if _, err := m.shims.Get(ctx, id); err == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: shim for id %q is registered", name, id)
+	} else if !errdefs.IsNotFound(err) {
+		return fmt.Errorf("refusing to recover hidden bundle %q: shim lookup for id %q failed: %w", name, id, err)
+	}
+
+	if _, err := m.containers.Get(ctx, id); err == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: container record for id %q exists", name, id)
+	} else if !errdefs.IsNotFound(err) {
+		return fmt.Errorf("refusing to recover hidden bundle %q: container lookup for id %q failed: %w", name, id, err)
+	}
+
+	if _, err := m.sandboxStore.Get(ctx, id); err == nil {
+		return fmt.Errorf("refusing to recover hidden bundle %q: sandbox record for id %q exists", name, id)
+	} else if !errdefs.IsNotFound(err) {
+		return fmt.Errorf("refusing to recover hidden bundle %q: sandbox lookup for id %q failed: %w", name, id, err)
+	}
+
+	hiddenPath := filepath.Join(stateDir, ns, name)
+	fi, err := os.Lstat(hiddenPath)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return fmt.Errorf("refusing to recover hidden bundle %q: failed to inspect hidden path: %w", name, err)
+	}
+	if !fi.IsDir() {
+		return fmt.Errorf("refusing to recover hidden bundle %q: hidden entry is not a bundle directory", name)
+	}
+
+	// A complete bundle tombstone still has the work symlink written by
+	// NewBundle. If it is present, it must name this ID's expected work tree.
+	// A partially removed tombstone may no longer have the link.
+	expectedWork := filepath.Join(rootDir, ns, id)
+	target, err := os.Readlink(filepath.Join(hiddenPath, "work"))
+	switch {
+	case err == nil:
+		if filepath.Clean(target) != filepath.Clean(expectedWork) {
+			return fmt.Errorf("refusing to recover hidden bundle %q: unexpected work directory target %q", name, target)
+		}
+	case errors.Is(err, os.ErrNotExist):
+		// The tombstone is incomplete; this is still safe to remove.
+	default:
+		return fmt.Errorf("refusing to recover hidden bundle %q: failed to inspect work link: %w", name, err)
+	}
+
+	if err := removeRecoverableBundleTombstone(stateDir, ns, rootDir, id, name); err != nil {
+		return fmt.Errorf("failed to remove stale bundle tombstone %q: %w", hiddenPath, err)
+	}
+
+	log.G(ctx).WithFields(log.Fields{
+		"id":        id,
+		"namespace": ns,
+		"path":      hiddenPath,
+	}).Info("recovered stale bundle tombstone")
+	return nil
+}
