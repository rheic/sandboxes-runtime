+package v2
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+)
+
+// TestRemoveRecoverableBundleTombstoneRejectsAnchoredOriginalCollision calls
+// the anchored Linux removal directly, bypassing the generic path checks, to
+// prove the dirfd walk independently rechecks for an original-path collision.
+func TestRemoveRecoverableBundleTombstoneRejectsAnchoredOriginalCollision(t *testing.T) {
+	requireConfinedRemoval(t)
+
+	stateDir := t.TempDir()
+	rootDir := t.TempDir()
+	id := "anchored-collision"
+	hidden := makeHiddenBundleTombstone(t, stateDir, rootDir, recoveryTestNamespace, id)
+	original := filepath.Join(stateDir, recoveryTestNamespace, id)
+	require.NoError(t, os.MkdirAll(original, 0o700))
+
+	err := removeRecoverableBundleTombstone(stateDir, recoveryTestNamespace, rootDir, id, "."+id)
+	require.ErrorContains(t, err, "original path")
+	require.DirExists(t, hidden)
+	require.FileExists(t, filepath.Join(hidden, "config.json"))
+}
+
+// TestRecoverStaleBundleTombstoneRejectsSymlinkedAncestor verifies that
+// recovery pins the configured state root from / instead of following a
+// symlinked ancestor into an outside canary tree.
+func TestRecoverStaleBundleTombstoneRejectsSymlinkedAncestor(t *testing.T) {
+	requireConfinedRemoval(t)
+
+	ctx := namespaces.WithNamespace(context.Background(), recoveryTestNamespace)
+	base := t.TempDir()
+	outside := t.TempDir()
+	stateDir := filepath.Join(base, "linked-ancestor", "state")
+	rootDir := filepath.Join(base, "root")
+	id := "ancestor-symlink"
+	hidden := filepath.Join(outside, "state", recoveryTestNamespace, "."+id)
+	work := filepath.Join(rootDir, recoveryTestNamespace, id)
+	canary := filepath.Join(hidden, "canary")
+
+	require.NoError(t, os.MkdirAll(filepath.Join(hidden, "rootfs"), 0o700))
+	require.NoError(t, os.MkdirAll(work, 0o700))
+	require.NoError(t, os.WriteFile(canary, []byte("CANARY"), 0o600))
+	require.NoError(t, os.Symlink(work, filepath.Join(hidden, "work")))
+	require.NoError(t, os.Symlink(outside, filepath.Join(base, "linked-ancestor")))
+
+	err := newRecoveryTestManager().recoverStaleBundleTombstone(ctx, stateDir, rootDir, "."+id)
+	require.ErrorContains(t, err, "symlink")
+	require.FileExists(t, canary)
+	data, err := os.ReadFile(canary)
+	require.NoError(t, err)
+	require.Equal(t, "CANARY", string(data))
+}
+
+// TestOpenStateRootRejectsRelativePath verifies recovery fails closed before
+// walking the filesystem when the configured state root is not absolute.
+func TestOpenStateRootRejectsRelativePath(t *testing.T) {
+	_, err := openStateRoot("relative/state")
+	require.ErrorContains(t, err, "not absolute")
+}
+
+// TestRecoverStaleBundleTombstoneRejectsSymlinkedNamespace verifies recovery
+// anchors the namespace beneath the state root instead of following an
+// ancestor symlink to an external directory.
+func TestRecoverStaleBundleTombstoneRejectsSymlinkedNamespace(t *testing.T) {
+	requireConfinedRemoval(t)
+
+	ctx := namespaces.WithNamespace(context.Background(), recoveryTestNamespace)
+	root := t.TempDir()
+	stateDir := filepath.Join(root, "state")
+	rootDir := filepath.Join(root, "root")
+	externalNS := filepath.Join(root, "external-ns")
+	id := "symlink-namespace"
+	hidden := filepath.Join(externalNS, "."+id)
+	work := filepath.Join(rootDir, recoveryTestNamespace, id)
+
+	require.NoError(t, os.MkdirAll(filepath.Join(hidden, "rootfs"), 0o700))
+	require.NoError(t, os.MkdirAll(work, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(hidden, "config.json"), []byte("{}"), 0o600))
+	require.NoError(t, os.Symlink(work, filepath.Join(hidden, "work")))
+	require.NoError(t, os.MkdirAll(stateDir, 0o700))
+	require.NoError(t, os.Symlink(externalNS, filepath.Join(stateDir, recoveryTestNamespace)))
+
+	err := newRecoveryTestManager().recoverStaleBundleTombstone(ctx, stateDir, rootDir, "."+id)
+	require.Error(t, err)
+	require.DirExists(t, hidden)
+	require.FileExists(t, filepath.Join(hidden, "config.json"))
+}
+
+// TestLoadShimsRecoversStaleOwnedBundleTombstone is the positive control:
+// startup recovery removes the hidden tree only when no owner exists, and the
+// same ID can then be created and deleted through the ordinary bundle
+// lifecycle.
+func TestLoadShimsRecoversStaleOwnedBundleTombstone(t *testing.T) {
+	requireConfinedRemoval(t)
+
+	ctx := namespaces.WithNamespace(context.Background(), recoveryTestNamespace)
+	stateDir := t.TempDir()
+	rootDir := t.TempDir()
+	id := "stale-tombstone"
+	hidden := makeHiddenBundleTombstone(t, stateDir, rootDir, recoveryTestNamespace, id)
+
+	m := newRecoveryTestManager()
+	protected, err := m.loadShims(ctx, stateDir, rootDir)
+	require.NoError(t, err)
+	require.Empty(t, protected)
+	if _, err := os.Lstat(hidden); !os.IsNotExist(err) {
+		t.Fatalf("hidden tombstone should be gone, got %v", err)
+	}
+
+	// The stale work tree is allowed to remain at this point; cleanupWorkDirs
+	// owns it. Creating the same ID again must still work, and its normal
+	// deletion must not collide with a leftover hidden entry.
+	bundle, err := NewBundle(ctx, rootDir, stateDir, id, nil)
+	require.NoError(t, err)
+	require.DirExists(t, bundle.Path)
+	require.NoError(t, bundle.Delete())
+	require.NoDirExists(t, bundle.Path)
+	require.NoDirExists(t, filepath.Join(rootDir, recoveryTestNamespace, id))
+	if _, err := os.Lstat(filepath.Join(stateDir, recoveryTestNamespace, "."+id)); !os.IsNotExist(err) {
+		t.Fatalf("hidden tombstone should not be recreated, got %v", err)
+	}
+}
