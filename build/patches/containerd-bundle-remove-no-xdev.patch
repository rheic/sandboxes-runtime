+package v2
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	api "github.com/containerd/containerd/api/runtime/task/v3"
+	"github.com/containerd/ttrpc"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/emptypb"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+type retryDeleteTaskClient struct {
+	TaskServiceClient
+	deleteCalls   int
+	shutdownCalls int
+	response      *api.DeleteResponse
+}
+
+func (c *retryDeleteTaskClient) Delete(context.Context, *api.DeleteRequest) (*api.DeleteResponse, error) {
+	c.deleteCalls++
+	if c.deleteCalls == 1 {
+		return c.response, nil
+	}
+	// The first ShimInstance.Delete closed the client. A task retry must
+	// tolerate the resulting closed-client error and use the cached exit.
+	return nil, ttrpc.ErrClosed
+}
+
+func (c *retryDeleteTaskClient) Shutdown(context.Context, *api.ShutdownRequest) (*emptypb.Empty, error) {
+	c.shutdownCalls++
+	return &emptypb.Empty{}, nil
+}
+
+type retryableShimInstance struct {
+	*shim
+	deleteCalls int
+	cleanupErr  error
+}
+
+func (s *retryableShimInstance) Delete(context.Context) error {
+	s.deleteCalls++
+	if err := s.shim.Close(); err != nil {
+		return err
+	}
+	if s.deleteCalls == 1 {
+		return s.cleanupErr
+	}
+	return nil
+}
+
+func TestShimTaskDeleteRetriesAfterCleanupFailureClosesClient(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	client := ttrpc.NewClient(clientConn)
+	t.Cleanup(func() {
+		_ = client.Close()
+		_ = serverConn.Close()
+	})
+
+	expectedExit := &api.DeleteResponse{
+		Pid:        77,
+		ExitStatus: 23,
+		ExitedAt:   timestamppb.New(time.Now().UTC().Truncate(time.Second)),
+	}
+	taskClient := &retryDeleteTaskClient{response: expectedExit}
+	shimInstance := &retryableShimInstance{
+		shim:       &shim{bundle: &Bundle{ID: "retry-delete"}, client: client},
+		cleanupErr: errors.New("injected bundle cleanup failure"),
+	}
+	shimTask := &shimTask{ShimInstance: shimInstance, task: taskClient}
+	removed := 0
+	removeTask := func(context.Context, string) { removed++ }
+
+	firstExit, err := shimTask.delete(context.Background(), removeTask)
+	require.ErrorIs(t, err, shimInstance.cleanupErr)
+	require.Nil(t, firstExit)
+	require.Zero(t, removed, "task record must remain available for retry")
+	err = client.Call(context.Background(), "test", "test", &emptypb.Empty{}, &emptypb.Empty{})
+	require.ErrorIs(t, err, ttrpc.ErrClosed)
+
+	secondExit, err := shimTask.delete(context.Background(), removeTask)
+	require.NoError(t, err)
+	require.Equal(t, uint32(77), secondExit.Pid)
+	require.Equal(t, uint32(23), secondExit.Status)
+	require.Equal(t, expectedExit.ExitedAt.AsTime(), secondExit.Timestamp)
+	require.Equal(t, 2, taskClient.deleteCalls)
+	require.Equal(t, 2, taskClient.shutdownCalls)
+	require.Equal(t, 2, shimInstance.deleteCalls)
+	require.Equal(t, 1, removed, "remove the task record only after cleanup succeeds")
+}
