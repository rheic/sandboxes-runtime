+func TestShimTaskDeleteRetriesBundleCleanupAfterClientClose(t *testing.T) {
+	if ok, reason := openat2ConfineSupported(t.TempDir()); !ok {
+		if errors.Is(reason, unix.ENOSYS) || errors.Is(reason, unix.EINVAL) {
+			t.Skipf("kernel lacks required openat2(2) primitive: %v", reason)
+		}
+		t.Fatalf("openat2(2) capability probe failed unexpectedly: %v", reason)
+	}
+
+	bundlePath := filepath.Join(t.TempDir(), "bundle")
+	require.NoError(t, os.MkdirAll(filepath.Join(bundlePath, "rootfs"), 0o700))
+	// atomicDeleteTree must not overwrite this stale sibling. It deterministically
+	// injects the first cleanup error without relying on privileges or a mount.
+	hiddenPath := filepath.Join(filepath.Dir(bundlePath), ".bundle")
+	require.NoError(t, os.Mkdir(hiddenPath, 0o700))
+
+	clientConn, serverConn := net.Pipe()
+	client := ttrpc.NewClient(clientConn)
+	t.Cleanup(func() {
+		_ = client.Close()
+		_ = serverConn.Close()
+	})
+
+	exitedAt := timestamppb.New(time.Now().UTC().Truncate(time.Second))
+	expectedExit := &api.DeleteResponse{Pid: 77, ExitStatus: 23, ExitedAt: exitedAt}
+	taskClient := &retryDeleteTaskClient{response: expectedExit}
+	shimInstance := &shim{
+		bundle: &Bundle{ID: "retry-delete", Path: bundlePath},
+		client: client,
+	}
+	shimTask := &shimTask{ShimInstance: shimInstance, task: taskClient}
+	removed := 0
+	removeTask := func(context.Context, string) { removed++ }
+
+	firstExit, err := shimTask.delete(context.Background(), removeTask)
+	require.Error(t, err, "bundle cleanup failure must be returned")
+	require.Nil(t, firstExit)
+	require.Zero(t, removed, "task record must remain available for retry")
+	err = client.Call(context.Background(), "test", "test", &emptypb.Empty{}, &emptypb.Empty{})
+	require.ErrorIs(t, err, ttrpc.ErrClosed, "the first cleanup attempt must have closed the client")
+	require.DirExists(t, bundlePath, "failed cleanup must leave the bundle available")
+
+	// Clear only the test collision; the bundle and its state are otherwise
+	// unchanged so the second Delete exercises the retained record.
+	require.NoError(t, os.Remove(hiddenPath))
+
+	secondExit, err := shimTask.delete(context.Background(), removeTask)
+	require.NoError(t, err)
+	require.Equal(t, uint32(77), secondExit.Pid)
+	require.Equal(t, uint32(23), secondExit.Status)
+	require.Equal(t, time.Unix(exitedAt.Seconds, int64(exitedAt.Nanos)).UTC(), secondExit.Timestamp.UTC())
+	require.Equal(t, 2, taskClient.deleteCalls)
+	require.Equal(t, 2, taskClient.shutdownCalls)
+	require.Equal(t, 1, removed, "the task record is removed only after cleanup succeeds")
+	require.NoDirExists(t, bundlePath)
+}
