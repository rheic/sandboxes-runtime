+	root := t.TempDir()
+	bundlePath := filepath.Join(root, "bundle-"+uniqueSuffix(t))
+	workPath := filepath.Join(root, "work-"+uniqueSuffix(t))
+	require.NoError(t, os.MkdirAll(filepath.Join(bundlePath, "rootfs"), 0o700))
+	require.NoError(t, os.MkdirAll(workPath, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(workPath, "state"), []byte("PRESERVE_UNTIL_RETRY"), 0o600))
+	require.NoError(t, os.Symlink(workPath, filepath.Join(bundlePath, "work")))
+
+	// An existing hidden sibling makes the work rename fail. Work-first
+	// ordering must leave the bundle available for a safe retry.
+	workAtomicPath := filepath.Join(root, "."+filepath.Base(workPath))
+	require.NoError(t, os.Mkdir(workAtomicPath, 0o700))
+	sentinel := filepath.Join(workAtomicPath, "sentinel")
+	require.NoError(t, os.WriteFile(sentinel, []byte("keep"), 0o600))
+
+	bundle := &Bundle{Path: bundlePath, workPath: workPath}
+	require.Error(t, bundle.Delete())
+	require.DirExists(t, bundlePath, "work-first failure must preserve the bundle")
+	require.FileExists(t, filepath.Join(bundlePath, "work"))
+	require.DirExists(t, workPath, "work cleanup failed and must remain for retry")
+	require.FileExists(t, filepath.Join(workPath, "state"))
+	require.FileExists(t, sentinel)
+
+	// Remove only the test's obstacle; the retry revalidates the exact work
+	// link and then removes work before bundle.
+	require.NoError(t, os.Remove(sentinel))
+	require.NoError(t, os.Remove(workAtomicPath))
+	require.NoError(t, bundle.Delete(), "retry must finish work and bundle cleanup")
+	require.NoDirExists(t, workPath)
+	require.NoDirExists(t, bundlePath)
+	if _, err := os.Lstat(workAtomicPath); !os.IsNotExist(err) {
+		t.Fatalf("hidden work path should be gone, got %v", err)
+	}
+
+	// Bundle.Delete only manages filesystem state; retrying it is idempotent
+	// and cannot publish another task event or duplicate a task record.
+	require.NoError(t, bundle.Delete(), "fully deleted bundle retry must be idempotent")
+}
