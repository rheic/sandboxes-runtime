+// TestBundleDeleteRejectsFileBindMount verifies preflight detects a file bind
+// mount before atomic cleanup can remove earlier bundle entries.
+func TestBundleDeleteRejectsFileBindMount(t *testing.T) {
+	if os.Getenv(mountTestEnv) != "1" {
+		t.Skipf("opt-in integration test: set %s=1 to run", mountTestEnv)
+	}
+	if os.Geteuid() != 0 {
+		t.Skip("skipping: mount privileges unavailable (requires root/CAP_SYS_ADMIN)")
+	}
+	requireConfinedRemoval(t)
+
+	dir, err := filepath.EvalSymlinks(t.TempDir())
+	require.NoError(t, err)
+	bundle := filepath.Join(dir, "rheic-file-bind-"+uniqueSuffix(t))
+	configPath := filepath.Join(bundle, "config.json")
+	require.NoError(t, os.MkdirAll(bundle, 0o700))
+	require.NoError(t, os.WriteFile(configPath, []byte("CONFIG_PRESERVE"), 0o600))
+	rootfs := filepath.Join(bundle, "rootfs")
+	require.NoError(t, os.MkdirAll(rootfs, 0o700))
+	source := filepath.Join(dir, "rheic-bind-source-"+uniqueSuffix(t))
+	target := filepath.Join(rootfs, "bind-file")
+	require.NoError(t, os.WriteFile(source, []byte("BIND_PRESERVE"), 0o600))
+	require.NoError(t, os.WriteFile(target, []byte("original"), 0o600))
+
+	var parentMount unix.Statx_t
+	require.NoError(t, unix.Statx(unix.AT_FDCWD, rootfs, 0, unix.STATX_MNT_ID, &parentMount))
+	if err := unix.Mount(source, target, "", unix.MS_BIND, ""); err != nil {
+		if errors.Is(err, unix.EPERM) || errors.Is(err, unix.EACCES) || errors.Is(err, unix.ENODEV) {
+			t.Skipf("skipping: bind mount privileges unavailable: %v", err)
+		}
+		t.Fatalf("failed to create test-owned file bind mount: %v", err)
+	}
+	var mounted unix.Statx_t
+	require.NoError(t, unix.Statx(unix.AT_FDCWD, target, 0, unix.STATX_MNT_ID, &mounted))
+	require.NotEqual(t, parentMount.Mnt_id, mounted.Mnt_id, "file bind mount must have its own mount id")
+	mountActive := true
+	t.Cleanup(func() {
+		if !mountActive {
+			return
+		}
+		var current unix.Statx_t
+		if err := unix.Statx(unix.AT_FDCWD, target, 0, unix.STATX_MNT_ID, &current); err != nil {
+			if !errors.Is(err, unix.ENOENT) {
+				t.Errorf("inspect owned file bind mount before cleanup: %v", err)
+			}
+			return
+		}
+		if current.Mnt_id != mounted.Mnt_id {
+			t.Errorf("refusing to unmount replaced path %q: mount id %d, own mount id %d", target, current.Mnt_id, mounted.Mnt_id)
+			return
+		}
+		if err := unix.Unmount(target, unix.UMOUNT_NOFOLLOW); err != nil && !errors.Is(err, unix.EINVAL) && !errors.Is(err, unix.ENOENT) {
+			t.Errorf("unmount test-owned file bind mount %q: %v", target, err)
+		}
+	})
+
+	err = (&Bundle{Path: bundle}).Delete()
+	require.ErrorIs(t, err, errCrossMount)
+	require.DirExists(t, bundle)
+	config, err := os.ReadFile(configPath)
+	require.NoError(t, err)
+	require.Equal(t, "CONFIG_PRESERVE", string(config), "preflight must not partially delete bundle entries")
+	data, err := os.ReadFile(target)
+	require.NoError(t, err)
+	require.Equal(t, "BIND_PRESERVE", string(data), "mounted file contents must remain intact")
+
+	if err := unix.Unmount(target, unix.UMOUNT_NOFOLLOW); err != nil {
+		t.Fatalf("detach test-owned file bind mount: %v", err)
+	}
+	mountActive = false
+	require.NoError(t, (&Bundle{Path: bundle}).Delete(), "ordinary cleanup succeeds after owned unmount")
+}
