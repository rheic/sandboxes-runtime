+	victim := filepath.Join(parent, "victim")
+	underlyingMarker := filepath.Join(victim, "marker")
+	require.NoError(t, os.MkdirAll(victim, 0o700))
+	require.NoError(t, os.WriteFile(underlyingMarker, []byte("UNDERLYING"), 0o600))
+
+	label := "rheic-parent-tmpfs-" + uniqueSuffix(t)
+	if err := unix.Mount(label, parent, "tmpfs", 0, "size=64k"); err != nil {
+		if errors.Is(err, unix.EPERM) || errors.Is(err, unix.EACCES) || errors.Is(err, unix.ENODEV) {
+			t.Skipf("skipping: mount privileges unavailable: %v", err)
+		}
