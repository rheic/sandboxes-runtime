+// makeHiddenBundleTombstone creates the exact on-disk shape left behind when
+// atomicDeleteTree renamed a bundle but could not remove or restore it.
+func makeHiddenBundleTombstone(t *testing.T, stateDir, rootDir, ns, id string) string {
+	t.Helper()
+
+	hidden := filepath.Join(stateDir, ns, "."+id)
+	work := filepath.Join(rootDir, ns, id)
+	require.NoError(t, os.MkdirAll(filepath.Join(hidden, "rootfs"), 0o700))
+	require.NoError(t, os.MkdirAll(work, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(hidden, "config.json"), []byte("{}"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(hidden, "rootfs", "file"), []byte("x"), 0o600))
+	require.NoError(t, os.Symlink(work, filepath.Join(hidden, "work")))
+	return hidden
+}
